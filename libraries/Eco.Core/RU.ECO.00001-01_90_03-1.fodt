     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P52"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">0x31</text:span></text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P53">Битовый маркер (упакованный массив флагов)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P52"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_1_STR_T</text:span></text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P52"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">0x32</text:span></text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P53">Символьная строка общего назначения</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P52"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_1_OBJECT_T</text:span></text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P52"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">0x33</text:span></text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P53">Абстрактная системная ссылка (Указатель на объект)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A32" office:value-type="string">
      <text:p text:style-name="P52"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_1_CUSTOM_T</text:span></text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A32" office:value-type="string">
      <text:p text:style-name="P52"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">0x3F</text:span></text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A32" office:value-type="string">
      <text:p text:style-name="P54">Пользовательский (расширяемый) тип структурированных данных</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P55"/>
   <text:list xml:id="list160916476600753" text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P56" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1"/>2.<text:span text:style-name="T1">2</text:span>. <text:s/>Битовая карта системных флагов конфигурации (ECO_TENSOR_FLAGS)<text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P55"/>
   <text:p text:style-name="P57"><text:span text:style-name="T25">Двухбайтовое поле (</text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">uint16_t</text:span></text:span><text:span text:style-name="T25">), определяющее логику разметки памяти, потоковую модель и права владения дескриптора.</text:span></text:p>
   <text:p text:style-name="P58"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T29">Биты: <text:s/>[15 . . . . 8] <text:s text:c="9"/>[7 . . 4] <text:s text:c="4"/>[3 . . . 0]</text:span></text:span></text:p>
   <text:p text:style-name="P59"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T30"><text:s text:c="7"/>└─────┬──────┘ └───┬───┘ └────┬────┘</text:span></text:span></text:p>
   <text:p text:style-name="P59"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T30"><text:s text:c="10"/></text:span></text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T29">Вычисления <text:s text:c="6"/>Управление <text:s text:c="2"/>Разреженность</text:span></text:span></text:p>
   <text:p text:style-name="P59"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T29"/></text:span></text:p>
   <text:list text:style-name="L6">
    <text:list-item>
     <text:p text:style-name="P60"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T26">Сегмент 1: Топология и разреженность памяти (Биты 0–3)</text:span></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_LAYOUT_DENSE (0x0000)</text:span></text:span><text:span text:style-name="T32">: Непрерывный плотный многомерный массив.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_LAYOUT_CSR (0x0001)</text:span></text:span><text:span text:style-name="T32">: Матричный формат со сжатием строк (Compressed Sparse Row).</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_LAYOUT_COO (0x0002)</text:span></text:span><text:span text:style-name="T32">: Координатный \(N\)-мерный разреженный формат.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_LAYOUT_CSF (0x0003)</text:span></text:span><text:span text:style-name="T32">: Древовидный разреженный формат (Compressed Sparse Fiber).</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_LAYOUT_SPARSE_24 (0x0004)</text:span></text:span><text:span text:style-name="T32">: Блочная аппаратная разреженность ИИ (2 из 4).</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_LAYOUT_CSC (0x0005)</text:span></text:span><text:span text:style-name="T32">: Матричный формат со сжатием столбцов (Compressed Sparse Column).</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_LAYOUT_ELLPACK (0x0006)</text:span></text:span><text:span text:style-name="T32">: Разреженный векторизованный формат ELL.</text:span></text:p>
   <text:list text:continue-numbering="true" text:style-name="L6">
    <text:list-item>
     <text:p text:style-name="P60"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T26">Сегмент 2: Бинарный формат и права владения (Биты 4–7)</text:span></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_SIMPLE_HDR (0x0008)</text:span></text:span><text:span text:style-name="T32">: Признак использования облегченного 8-байтового заголовка.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_COM (0x0010)</text:span></text:span><text:span text:style-name="T32">: Включение диспетчеризации и подсчета ссылок через </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">lpVtbl</text:span></text:span><text:span text:style-name="T32">.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_FOREIGN (0x0020)</text:span></text:span><text:span text:style-name="T32">: Память принадлежит внешней среде (SaC). Запрет вызова </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">free()</text:span></text:span><text:span text:style-name="T32"> в деструкторе.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_READONLY (0x0040)</text:span></text:span><text:span text:style-name="T32">: Защита буфера от модификации процессом.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_VIEW (0x0080)</text:span></text:span><text:span text:style-name="T32">: Признак виртуального среза памяти другого мастер-тензора.</text:span></text:p>
   <text:list text:continue-numbering="true" text:style-name="L6">
    <text:list-item>
     <text:p text:style-name="P60"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T26">Сегмент 3: Аппаратная оптимизация (Биты 8–11)</text:span></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_PINNED (0x0100)</text:span></text:span><text:span text:style-name="T32">: Невзвешенная хост-память (Page-Locked) для DMA-трансфера.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_DEVICE (0x0200)</text:span></text:span><text:span text:style-name="T32">: Память на ускорителе (CUDA Pointer / GPU VRAM). CPU доступ закрыт.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_SHARED (0x0400)</text:span></text:span><text:span text:style-name="T32">: Межпроцессная разделяемая память (IPC Shared Memory).</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_ALIGNED_PAGE (0x0800)</text:span></text:span><text:span text:style-name="T32">: Выравнивание адреса данных по границе страницы ОС (4 КБ).</text:span></text:p>
   <text:list text:continue-numbering="true" text:style-name="L6">
    <text:list-item>
     <text:p text:style-name="P60"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T26">Сегмент 4: Потоковая оптимизация (Биты 12–15)</text:span></text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_THREADSAFE (0x1000)</text:span></text:span><text:span text:style-name="T32">: Модификация счетчиков строго через атомарные инструкции.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_DIRTY (0x2000)</text:span></text:span><text:span text:style-name="T32">: Признак рассинхронизации данных между CPU и GPU.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_CONTIGUOUS (0x4000)</text:span></text:span><text:span text:style-name="T32">: Гарантированная непрерывность памяти по всем осям.</text:span></text:p>
   <text:p text:style-name="P61"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T31">ECO_TENSOR_FLAG_CONTINGENT (0x8000)</text:span></text:span><text:span text:style-name="T32">: Флаг отложенных/ленивых вычислений.</text:span></text:p>
   <text:p text:style-name="P62"/>
   <text:p text:style-name="P63"/>
   <text:list text:continue-list="list160916476600753" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P25" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72889_228845717"/>3. БИНАРНЫЕ И РАНТАЙМ СТРУКТУРЫ<text:bookmark-end text:name="__RefHeading___Toc72889_228845717"/><text:bookmark-start text:name="__RefHeading___Toc72889_228845717 Copy 1"/></text:h>
     <text:h text:style-name="P64" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1"/><text:span text:style-name="T33">3</text:span><text:span text:style-name="T34">.</text:span><text:span text:style-name="T33">1</text:span><text:span text:style-name="T34">. <text:s/>Структура ECO_TENSOR_V1_T (Полный заголовок)</text:span><text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P63"/>
   <text:p text:style-name="P65">Монолитный упакованный блок метаданных размером строго 16 байт. Предназначен для обмена по сети, сохранения на диск и полного управления жизненным циклом.</text:p>
   <text:p text:style-name="P63"/>
   <text:p text:style-name="P66">typedef struct ECO_TENSOR_V1_T {<text:line-break/> <text:s text:c="3"/>uint32_t magic; <text:s text:c="7"/>/* Системный маркер порядка байт и версии (Версия всегда 0x01) */<text:line-break/> <text:s text:c="3"/>uint32_t ref_count; <text:s text:c="3"/>/* Счетчик активных ссылок (Интеграция COM / SaC) */<text:line-break/> <text:s text:c="3"/>uint16_t ndims; <text:s text:c="7"/>/* Количество пространственных измерений (Ранг тензора) */<text:line-break/> <text:s text:c="3"/>uint16_t flags; <text:s text:c="7"/>/* Системные флаги конфигурации (см. п. 2.2) */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>data_type; <text:s text:c="3"/>/* Физический тип данных элементов (см. п. 2.1) */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>shape_type; <text:s text:c="2"/>/* Размерность типов данных в массиве shape (1, 2, 4, 8 байт) */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>data_align; <text:s text:c="2"/>/* Выравнивание буфера данных, выраженное в степени двойки */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>shape_align; <text:s/>/* Выравнивание буфера геометрии, выраженное в степени двойки */<text:line-break/>} ECO_TENSOR_V1_T;</text:p>
   <text:p text:style-name="P63"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P64" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="T33">3</text:span><text:span text:style-name="T34">.</text:span><text:span text:style-name="T33">2</text:span><text:span text:style-name="T34">. <text:s/>Структура ECO_SIMPLE_TENSOR_V1_T (Облегченный заголовок)</text:span><text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P68">Минималистичный упакованный блок метаданных размером строго 8 байт. Используется для высокопроизводительного инференса нейросетей, где исключен оверхед на подсчет ссылок и проверку magic. Данные осей ndims могут быть любыми.</text:p>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P66">typedef struct ECO_SIMPLE_TENSOR_V1_T {<text:line-break/> <text:s text:c="3"/>uint16_t ndims; <text:s text:c="7"/>/* Количество пространственных измерений */<text:line-break/> <text:s text:c="3"/>uint16_t flags; <text:s text:c="7"/>/* Системные флаги (Обязательно взведен ECO_TENSOR_FLAG_SIMPLE_HDR) */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>data_type; <text:s text:c="3"/>/* Физический тип данных элементов */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>shape_type; <text:s text:c="2"/>/* Степень двойки для размера элементов осей */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>data_align; <text:s text:c="2"/>/* Выравнивание буфера данных */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>shape_align; <text:s/>/* Выравнивание буфера геометрии */<text:line-break/>} ECO_SIMPLE_TENSOR_V1_T;<text:line-break/></text:p>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P69"/>
   <text:p text:style-name="P70"><text:span text:style-name="T35">3</text:span><text:span text:style-name="T36">.</text:span><text:span text:style-name="T37">3</text:span><text:span text:style-name="T36">. <text:s/>Структура ECO_RUNTIME_TENSOR_V1_T (Рантайм-дескриптор)</text:span></text:p>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P68">Управляющий контекст объекта в оперативной памяти хоста. Размер на 64-битных архитектурах равен 64 байтам (эквивалент одной строки кэша L1 CPU). На первой позиции содержит lpVtbl интерфейса IEcoUnknown для делегирования контроля памяти внешним средам.</text:p>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P66">typedef struct ECO_RUNTIME_TENSOR_V1_T {<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>lpVtbl; <text:s text:c="9"/>/* Указатель на интерфейс IEcoUnknown управления памятью */<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_V1_T hdr; <text:s text:c="12"/>/* Встроенный полный бинарный заголовок метаданных */<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>shape_ptr; <text:s text:c="6"/>/* Адрес Си-массива размеров осей (Входной мост для SaC) */<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>data_ptr; <text:s text:c="7"/>/* Адрес Си-массива элементов (Для DENSE или values для CSR) */<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>sparse_indices; <text:s/>/* Вспомогательный адрес индексов для разреженных структур */<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>sparse_indptr; <text:s text:c="2"/>/* Вспомогательный адрес указателей строк (Строго для CSR) */<text:line-break/> <text:s text:c="3"/>uint64_t <text:s text:c="7"/>nnz; <text:s text:c="12"/>/* Точное количество ненулевых элементов (Валидно при SPARSE) */<text:line-break/>} ECO_RUNTIME_TENSOR_V1_T;<text:line-break/></text:p>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P67"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P71" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72889_228845717 Copy 2"/><text:span text:style-name="T38">4</text:span>. ОПИСАНИЕ ИНТЕРФЕЙСА IEcoTensor1<text:bookmark-end text:name="__RefHeading___Toc72889_228845717 Copy 2"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P72"/>
   <text:p text:style-name="P72">[<text:line-break/> <text:s text:c="3"/>object,<text:line-break/> <text:s text:c="3"/>uguid({00000000-0000-0000-0000-0001FDFEFF}),<text:line-break/>]<text:line-break/>interface IEcoTensor1 : IEcoUnknown {<text:line-break/><text:line-break/>}</text:p>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P64" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2"/><text:span text:style-name="T39">4</text:span><text:span text:style-name="T34">.</text:span><text:span text:style-name="T33">1</text:span><text:span text:style-name="T34">. <text:s/>Системный идентификатор (IID)</text:span><text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P68">Интерфейс однозначно идентифицируется в компонентной системе с помощью математически сформированного 128-битного уникального номера (UGUID). Пограничный суффикс IID сформирован на основе физического расположения Little-Endian маркера magic первой версии тензора.</text:p>
   <text:p text:style-name="P68"/>
   <text:p text:style-name="P66">IID_IEcoTensor1 = { 0x01, 0x10, {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0xFD, 0xFE, 0xFF} };</text:p>
   <text:p text:style-name="P68"/>
   <text:list xml:id="list160916152987038" text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P64" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 1"/><text:span text:style-name="T39">4</text:span><text:span text:style-name="T34">.</text:span><text:span text:style-name="T39">2</text:span><text:span text:style-name="T34">. <text:s/>Назначение интерфейса</text:span><text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P67"/>
   <text:p text:style-name="P68">Интерфейс IEcoTensor1 является базовым пассивным интерфейсом первой версии. Согласно выбранной сервис-ориентированной архитектуре, данный интерфейс не содержит методов бизнес-логики или математических абстракций.</text:p>
   <text:p text:style-name="P68"/>
   <text:p text:style-name="P68">Его vtable наследуется от IEcoUnknown и служит исключительно точкой входа для:</text:p>
   <text:list text:style-name="L7">
    <text:list-item>
     <text:p text:style-name="P73">Диспетчеризации версий метаданных посредством вызова QueryInterface.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P73">Синхронизации времени жизни памяти пассивного дескриптора между рантаймом компилятора SaC и внешними компонентными приложениями (<text:span text:style-name="T38">A</text:span>COM/COM) через унифицированные вызовы AddRef и Release.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P74"/>
   <text:list text:continue-list="list160916152987038" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P75" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1"/><text:span text:style-name="T40">5</text:span><text:span text:style-name="T41">. </text:span>ПРАВИЛА И ИНВАРИАНТЫ ВАЛИДАЦИИ <text:bookmark-end text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P76"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P77" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2"/><text:span text:style-name="T42">5</text:span><text:span text:style-name="T43">.</text:span><text:span text:style-name="T44">1</text:span><text:span text:style-name="T43">. <text:s/>Инварианты геометрической конфигурации (Shape &amp; Dimensions)</text:span><text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P79"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T26">Правило 5.1.1 (Контроль нулевого объема):</text:span></text:span><text:span text:style-name="T25"> Движок обязан блокировать создание или инициализацию тензоров, у которых хотя бы одна из осей в массиве </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">shape_ptr</text:span></text:span><text:span text:style-name="T25"> равна </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">0</text:span></text:span><text:span text:style-name="T25">. Тензоры нулевого объема запрещены.</text:span></text:p>
   <text:p text:style-name="P80"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T26">Правило 5.1.2 (Максимальный ранг):</text:span></text:span><text:span text:style-name="T25"> Количество измерений </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ndims</text:span></text:span><text:span text:style-name="T25"> не может превышать значение </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">65535</text:span></text:span><text:span text:style-name="T25">. При этом для макетов, отличных от </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">DENSE</text:span></text:span><text:span text:style-name="T25"> и </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">COO</text:span></text:span><text:span text:style-name="T25">, действуют жесткие пространственные ограничения.</text:span></text:p>
   <text:p text:style-name="P80"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T26">Правило 5.1.3 (Ограничения CSR/CSC):</text:span></text:span><text:span text:style-name="T25"> Если в поле </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">hdr.flags</text:span></text:span><text:span text:style-name="T25"> установлена маска </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_LAYOUT_CSR</text:span></text:span><text:span text:style-name="T25"> или </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_LAYOUT_CSC</text:span></text:span><text:span text:style-name="T25">, значение </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ndims</text:span></text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T26">обязано</text:span></text:span><text:span text:style-name="T25"> быть строго равно </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">2</text:span></text:span><text:span text:style-name="T25">.</text:span></text:p>
   <text:p text:style-name="P81">Сценарий валидации 5.1 (Код на Си):</text:p>
   <text:p text:style-name="P66">int16_t EcoTensor_ValidateGeometry(const ECO_RUNTIME_TENSOR_V1_T* pTensor) {<text:line-break/> <text:s text:c="3"/>uint16_t layout = pTensor-&gt;hdr.flags &amp; ECO_TENSOR_LAYOUT_MASK;<text:line-break/> <text:s text:c="3"/>uint16_t i;<text:line-break/><text:line-break/> <text:s text:c="3"/>if (pTensor-&gt;hdr.ndims == 0) return -1; /* Ошибка: ранг не может быть нулевым */<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Валидация разреженных матричных форматов */<text:line-break/> <text:s text:c="3"/>if (layout == ECO_TENSOR_LAYOUT_CSR || layout == ECO_TENSOR_LAYOUT_CSC) {<text:line-break/> <text:s text:c="7"/>if (pTensor-&gt;hdr.ndims != 2) return -2; /* Ошибка: CSR/CSC строго 2D */<text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Проверка элементов массива shape_ptr */<text:line-break/> <text:s text:c="3"/>if (pTensor-&gt;shape_ptr == NULL) return -3;<text:line-break/> <text:s text:c="3"/>for (i = 0; i &lt; pTensor-&gt;hdr.ndims; i++) {<text:line-break/> <text:s text:c="7"/>uint32_t dim_size = ((const uint32_t*)pTensor-&gt;shape_ptr)[i];<text:line-break/> <text:s text:c="7"/>if (dim_size == 0) return -4; /* Ошибка: размер оси не может быть равен 0 */<text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>return 0; /* Геометрия валидна */<text:line-break/>}</text:p>
   <text:p text:style-name="P82"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P83" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 1"/><text:span text:style-name="T45">5</text:span><text:span text:style-name="T36">.</text:span><text:span text:style-name="T45">2</text:span><text:span text:style-name="T36">. <text:s/>Инварианты управления памятью и внешних данных (</text:span><text:span text:style-name="T46">Bridge</text:span><text:span text:style-name="T36">)</text:span><text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P84"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T47">Правило 5.2.1 (Изоляция FOREIGN):</text:span></text:span> Флаг <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">ECO_TENSOR_FLAG_FOREIGN</text:span></text:span> указывает, что физические буферы <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">shape_ptr</text:span></text:span> и <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">data_ptr</text:span></text:span> выделены внешней средой исполнения (компилятором SaC). Ядро EcoTensor не имеет права изменять их размер через <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">realloc</text:span></text:span> или освобождать через <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">free</text:span></text:span>.</text:p>
   <text:p text:style-name="P85"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Правило 5.2.2 (Контроль READONLY мутаций):</text:span></text:span><text:span text:style-name="T50"> Любая попытка записи значения (чевет вызов </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">Set</text:span></text:span><text:span text:style-name="T50"> сервиса) или вызов метода очистки </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">Clear</text:span></text:span><text:span text:style-name="T50"> для тензора со взведенным флагом </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_FLAG_READONLY</text:span></text:span><text:span text:style-name="T50"> должна мгновенно прерываться с возвратом кода аппаратной защиты.</text:span></text:p>
   <text:p text:style-name="P86"/>
   <text:p text:style-name="P81"><text:soft-page-break/>Сценарий валидации 5.2 (Код на Си):</text:p>
   <text:p text:style-name="P66">int16_t EcoTensor_ValidateMutationAccess(const ECO_RUNTIME_TENSOR_V1_T* pTensor) {<text:line-break/> <text:s text:c="3"/>/* Проверка защиты от записи (Memory Map / View) */<text:line-break/> <text:s text:c="3"/>if (pTensor-&gt;hdr.flags &amp; ECO_TENSOR_FLAG_READONLY) {<text:line-break/> <text:s text:c="7"/>return -5; /* Ошибка: Доступ запрещен, тензор только для чтения */<text:line-break/> <text:s text:c="3"/>}<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>/* Если данные внешние (SaC), мы проверяем, не пустые ли они */<text:line-break/> <text:s text:c="3"/>if (pTensor-&gt;hdr.flags &amp; ECO_TENSOR_FLAG_FOREIGN) {<text:line-break/> <text:s text:c="7"/>if (!pTensor-&gt;data_ptr || !pTensor-&gt;shape_ptr) {<text:line-break/> <text:s text:c="11"/>return -6; /* Ошибка: Внешние указатели SaC не инициализированы */<text:line-break/> <text:s text:c="7"/>}<text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>return 0; /* Модификация разрешена */<text:line-break/>}</text:p>
   <text:p text:style-name="P84"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P87" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 1 Copy 1"/>5.<text:span text:style-name="T51">3</text:span>. Инварианты разреженных структур (Sparse Data Consistency) <text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 1 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P84"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T47">Правило 5.3.1 (Контроль переполнения NNZ):</text:span></text:span> Общее количество ненулевых элементов <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">nnz</text:span></text:span> плотного тензора не может превышать его полный математический объем (Volume). Для разреженных тензоров <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">nnz</text:span></text:span> должно строго соответствовать выделенным объемам индексных буферов.</text:p>
   <text:p text:style-name="P85"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Правило 5.3.2 (Целостность CSR-массивов):</text:span></text:span><text:span text:style-name="T50"> При использовании макета </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_LAYOUT_CSR</text:span></text:span><text:span text:style-name="T50">, размер буфера строк </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">sparse_indptr</text:span></text:span><text:span text:style-name="T50"> обязан быть равен </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">(shape_ptr[0] + 1) * sizeof(uint32_t)</text:span></text:span><text:span text:style-name="T50">. Последний элемент массива </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">sparse_indptr</text:span></text:span><text:span text:style-name="T50"> должен быть строго равен значению </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">nnz</text:span></text:span><text:span text:style-name="T50">.</text:span></text:p>
   <text:p text:style-name="P81">Сценарий валидации 5.3 (Код на Си):</text:p>
   <text:p text:style-name="P66">int16_t EcoTensor_ValidateSparseIntegrity(const ECO_RUNTIME_TENSOR_V1_T* pTensor) {<text:line-break/> <text:s text:c="3"/>uint16_t layout = pTensor-&gt;hdr.flags &amp; ECO_TENSOR_LAYOUT_MASK;<text:line-break/><text:line-break/> <text:s text:c="3"/>if (layout == ECO_TENSOR_LAYOUT_DENSE) {<text:line-break/> <text:s text:c="7"/>if (pTensor-&gt;sparse_indices != NULL || pTensor-&gt;sparse_indptr != NULL) {<text:line-break/> <text:s text:c="11"/>return -7; /* Ошибка: Плотный тензор содержит указатели разреженности */<text:line-break/> <text:s text:c="7"/>}<text:line-break/> <text:s text:c="7"/>return 0;<text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Валидация разреженного формата CSR */<text:line-break/> <text:s text:c="3"/>if (layout == ECO_TENSOR_LAYOUT_CSR) {<text:line-break/> <text:s text:c="7"/>uint32_t rows = ((const uint32_t*)pTensor-&gt;shape_ptr)[0];<text:line-break/> <text:s text:c="7"/>const uint32_t* row_ptr = (const uint32_t*)pTensor-&gt;sparse_indptr;<text:line-break/><text:line-break/> <text:s text:c="7"/>if (!pTensor-&gt;sparse_indices || !pTensor-&gt;sparse_indptr) {<text:line-break/> <text:s text:c="11"/>return -8; /* Ошибка: Отсутствуют буферы индексов CSR */<text:line-break/> <text:s text:c="7"/>}<text:line-break/><text:line-break/> <text:s text:c="7"/>/* Критическая проверка связности граней: последний элемент indptr == nnz */<text:line-break/> <text:s text:c="7"/>if (row_ptr[rows] != pTensor-&gt;nnz) {<text:line-break/> <text:s text:c="11"/>return -9; /* Ошибка: Нарушена целостность структуры строк CSR */<text:line-break/> <text:s text:c="7"/>}<text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>return 0; /* Структура разреженности целостна */<text:line-break/>}<text:line-break/></text:p>
   <text:p text:style-name="P84"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P87" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1216_1657644706"/><text:soft-page-break/>5.<text:span text:style-name="T51">4</text:span>. Инварианты физического формата заголовков (Full vs Simple HDR)<text:bookmark-end text:name="__RefHeading___Toc1216_1657644706"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P84"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T47">Правило 5.4.1 (Взаимное исключение COM и SIMPLE):</text:span></text:span> Тензор не может одновременно обладать флагами <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">ECO_TENSOR_FLAG_SIMPLE_HDR</text:span></text:span> и <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">ECO_TENSOR_FLAG_COM</text:span></text:span>. Облегченный заголовок исключает компонентный подсчет ссылок.</text:p>
   <text:p text:style-name="P85"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Правило 5.4.2 (Маппинг памяти в QueryInterface):</text:span></text:span><text:span text:style-name="T50"> При получении запроса на интерфейс </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">IID_ECO_SIMPLE_TENSOR_V1_HDR</text:span></text:span><text:span text:style-name="T50">, если исходный тензор является полным (</text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">FULL</text:span></text:span><text:span text:style-name="T50">), рантайм-вычислитель производит сдвиг адреса строго на </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">8 байт</text:span></text:span><text:span text:style-name="T50">. Поля </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">data_type</text:span></text:span><text:span text:style-name="T50">, </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">flags</text:span></text:span><text:span text:style-name="T50"> и </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ndims</text:span></text:span><text:span text:style-name="T50"> при этом обязаны идеально наложиться на структуру </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_SIMPLE_TENSOR_V1_T</text:span></text:span><text:span text:style-name="T50">.</text:span></text:p>
   <text:p text:style-name="P81">Сценарий валидации 5.4 (Код на Си):</text:p>
   <text:p text:style-name="code_5f_cpp"><text:span text:style-name="T52">int16_t EcoTensor_ValidateHeaderFormat(const ECO_RUNTIME_TENSOR_V1_T* pTensor) {<text:line-break/> <text:s text:c="3"/>uint16_t flags = pTensor-&gt;hdr.flags;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Проверка на конфликт системных концепций */<text:line-break/> <text:s text:c="3"/>if ((flags &amp; ECO_TENSOR_FLAG_SIMPLE_HDR) &amp;&amp; (flags &amp; ECO_TENSOR_FLAG_COM)) {<text:line-break/> <text:s text:c="7"/>return -10; /* Ошибка: Несовместимая конфигурация заголовка (COM + SIMPLE) */<text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Если это полный заголовок, проверяем корректность магического числа */<text:line-break/> <text:s text:c="3"/>if (!(flags &amp; ECO_TENSOR_FLAG_SIMPLE_HDR)) {<text:line-break/> <text:s text:c="7"/>if (pTensor-&gt;hdr.magic != ECO_TENSOR_MAGIC_LE &amp;&amp; <text:line-break/> <text:s text:c="11"/>pTensor-&gt;hdr.magic != ECO_TENSOR_MAGIC_BE &amp;&amp; <text:line-break/> <text:s text:c="11"/>pTensor-&gt;hdr.magic != ECO_TENSOR_MAGIC_ME) {<text:line-break/> <text:s text:c="11"/>return -11; /* Ошибка: Бинарный маркер magic поврежден */<text:line-break/> <text:s text:c="7"/>}<text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>return 0; /* Бинарный формат заголовка корректен */<text:line-break/>}</text:span><text:line-break/> </text:p>
   <text:p text:style-name="P84"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P75" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="T40">6</text:span><text:span text:style-name="T41">. АЛГОРИТМЫ И МЕТОДЫ ВЫЧИСЛЕНИЯ СДВИГОВ (STRIDES) ДЛЯ DENSE-ПРОСТРАНСТВ</text:span><text:bookmark-end text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P76"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P77" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 2"/><text:span text:style-name="T42">6</text:span><text:span text:style-name="T43">.</text:span><text:span text:style-name="T44">1</text:span><text:span text:style-name="T43">. <text:s/>Теоретическое обоснование и математический базис</text:span><text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 2"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P88"><text:span text:style-name="T50">В плотном многомерном пространстве (</text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_LAYOUT_DENSE</text:span></text:span><text:span text:style-name="T50">) элементы хранятся в памяти в виде непрерывного одномерного массива байт. Порядок размещения элементов фиксируется как </text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Row-Major</text:span></text:span><text:span text:style-name="T50"> (канонический стиль языка Си), при котором элементы последней оси располагаются в памяти последовательно, а шаг по первой оси является наибольшим.</text:span></text:p>
   <text:p text:style-name="P89"><text:span text:style-name="T25">Для тензора ранга \(R\) (</text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ndims</text:span></text:span><text:span text:style-name="T25">), вектор размеров осей которого задан как \(S = (s_0, s_1, \dots, s_{R-1})\), вектор шагов адресации \(T = (t_0, t_1, \dots, t_{R-1})\) определяет количество элементов, которое необходимо пропустить в памяти для перемещения на одну позицию вперед по соответствующей координате.</text:span></text:p>
   <text:p text:style-name="P29">Математическая формула вычисления шага \(t_{i}\) для \(i\)-й оси определяется рекуррентным соотношением:</text:p>
   <text:p text:style-name="P29">\(t_{R-1}=1\)</text:p>
   <text:p text:style-name="P29">\(t_{i}=t_{i+1}\times s_{i+1},\quad \text{при}\quad 0\le i&lt;R-1\)</text:p>
   <text:p text:style-name="P29">Или в явном виде произведения:</text:p>
   <text:p text:style-name="P29">\(t_{i}=\prod _{j=i+1}^{R-1}s_{j}\)</text:p>
   <text:p text:style-name="P29">Полный математический объем тензора (общее количество элементов, Volume) эквивалентен величине:</text:p>
   <text:p text:style-name="P29">\(V=t_{0}\times s_{0}=\prod _{j=0}^{R-1}s_{j}\)</text:p>
   <text:p text:style-name="P90"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P77" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 2 Copy 1"/><text:span text:style-name="T42">6</text:span><text:span text:style-name="T43">.</text:span><text:span text:style-name="T44">1</text:span><text:span text:style-name="T43">. <text:s/>Формула отображения многомерного индекса (Линеаризация)</text:span><text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 2 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P91">Для заданного вектора многомерных координат (индексов) \(I = (i_0, i_1, \dots, i_{R-1})\), где \(0 \le i_k &lt; s_k\), плоский логический индекс элемента \(FlatIndex\) вычисляется как скалярное произведение вектора индексов на вектор шагов:</text:p>
   <text:p text:style-name="P29">\(FlatIndex=\sum _{k=0}^{R-1}(i_{k}\times t_{k})=i_{0}\cdot t_{0}+i_{1}\cdot t_{1}+\dots +i_{R-1}\cdot t_{R-1}\)</text:p>
   <text:p text:style-name="P29">Физический адрес байта в памяти хоста \(Address\) с учетом размера одного элемента \(SizeOf(DataType)\) рассчитывается как:</text:p>
   <text:p text:style-name="P29">\(Address=\text{BaseAddress}+(FlatIndex\times \text{SizeOf}(DataType))\)</text:p>
   <text:p text:style-name="P91"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P75" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 2"/><text:span text:style-name="T40">7</text:span><text:span text:style-name="T41">. ПРОГРАММНАЯ РЕАЛИЗАЦИЯ И ВЕКТОРНЫЕ ВЫЧИСЛЕНИЯ</text:span> <text:bookmark-end text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 2"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P76"/>
   <text:p text:style-name="P92">Поскольку в пассивной бинарной структуре <text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_V1_T</text:span></text:span> и рантайм-дескрипторе ради экономии памяти массив <text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">strides</text:span></text:span> физически отсутствует, вычислительный сервис <text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">IEcoTensorEngine1</text:span></text:span> рассчитывает шаги динамически &quot;на лету&quot; на стеке процессора, либо кэширует их в вызывающем потоке. </text:p>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P87" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3"/>7.<text:span text:style-name="T53">1</text:span>. <text:s/>Алгоритм динамического вычисления шагов и проверки границ<text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P84">Ниже приведен защищенный программный код вычислительного ядра на языке Си (C89). Алгоритм устойчив к переполнениям типов и аппаратно независим от разрядности массива <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">shape_ptr</text:span></text:span> (<text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">uint32_t</text:span></text:span> или <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">uint64_t</text:span></text:span>).</text:p>
   <text:p text:style-name="P84"/>
   <text:p text:style-name="code_5f_cpp"><text:span text:style-name="T52">#include &lt;stdint.h&gt;<text:line-break/>#include &lt;stddef.h&gt;<text:line-break/><text:line-break/>/* Локальная структура для изоляции расчетного контекста на стеке */<text:line-break/>typedef struct ECO_LOCAL_STRIDE_CTX {<text:line-break/> <text:s text:c="3"/>size_t flat_index;<text:line-break/> <text:s text:c="3"/>size_t current_stride;<text:line-break/> <text:s text:c="3"/>int16_t status;<text:line-break/>} ECO_LOCAL_STRIDE_CTX;<text:line-break/><text:line-break/>/**<text:line-break/> * Локальный сервисный метод вычисления линеаризованного индекса<text:line-break/> * Возвращает 0 при успешном расчете, отрицательный код при выходе за границы (OOB)<text:line-break/> */<text:line-break/>int16_t EcoTensor_CalculateFlatIndex(<text:line-break/> <text:s text:c="3"/>const ECO_RUNTIME_TENSOR_V1_T* pTensor, <text:line-break/> <text:s text:c="3"/>const uint32_t* pIndices, <text:line-break/> <text:s text:c="3"/>size_t* pOutFlatIndex<text:line-break/>) {<text:line-break/> <text:s text:c="3"/>ECO_LOCAL_STRIDE_CTX ctx;<text:line-break/> <text:s text:c="3"/>int32_t i;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>if (!pTensor || !pIndices || !pOutFlatIndex) return -2147467261; /* E_POINTER */<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>ctx.flat_index = 0;<text:line-break/> <text:s text:c="3"/>ctx.current_stride = 1;<text:line-break/> <text:s text:c="3"/>ctx.status = 0;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Обход осей в обратном порядке (от младшей оси к старшей) для Row-Major */<text:line-break/> <text:s text:c="3"/>for (i = (int32_t)pTensor-&gt;hdr.ndims - 1; i &gt;= 0; i--) {<text:line-break/> <text:s text:c="7"/>size_t dim_size = 0;<text:line-break/><text:line-break/> <text:s text:c="7"/>/* Безопасное чтение размера текущей оси с учетом shape_type */<text:line-break/> <text:s text:c="7"/>if (pTensor-&gt;hdr.shape_type == 0x02) { /* uint32_t */<text:line-break/> <text:s text:c="11"/>dim_size = (size_t)((const uint32_t*)pTensor-&gt;shape_ptr)[i];<text:line-break/> <text:s text:c="7"/>} else if (pTensor-&gt;hdr.shape_type == 0x03) { /* uint64_t */<text:line-break/> <text:s text:c="11"/>dim_size = (size_t)((const uint64_t*)pTensor-&gt;shape_ptr)[i];<text:line-break/> <text:s text:c="7"/>} else if (pTensor-&gt;hdr.shape_type == 0x01) { /* uint16_t */<text:line-break/> <text:s text:c="11"/>dim_size = (size_t)((const uint16_t*)pTensor-&gt;shape_ptr)[i];<text:line-break/> <text:s text:c="7"/>} else { /* uint8_t */<text:line-break/> <text:s text:c="11"/>dim_size = (size_t)((const uint8_t*)pTensor-&gt;shape_ptr)[i];<text:line-break/> <text:s text:c="7"/>}<text:line-break/><text:line-break/> <text:s text:c="7"/>/* КРИТИЧЕСКИЙ ИНВАРИАНТ: Проверка выхода индекса за границы текущей оси */<text:line-break/> <text:s text:c="7"/>if ((size_t)pIndices[i] &gt;= dim_size) {<text:line-break/> <text:s text:c="11"/>return -101; /* Ошибка: Индекс [i] за границами размерности оси (OOB) */<text:line-break/> <text:s text:c="7"/>}<text:line-break/><text:line-break/> <text:s text:c="7"/>/* Накопление плоского смещения */<text:line-break/> <text:s text:c="7"/>ctx.flat_index += (size_t)pIndices[i] * ctx.current_stride;<text:line-break/> <text:s text:c="7"/><text:line-break/></text:span><text:soft-page-break/><text:span text:style-name="T52"> <text:s text:c="7"/>/* Защита от арифметического переполнения при расчете stride */<text:line-break/> <text:s text:c="7"/>if (dim_size &gt; 0 &amp;&amp; ctx.current_stride &gt; (SIZE_MAX / dim_size)) {<text:line-break/> <text:s text:c="11"/>return -102; /* Ошибка: Математическое переполнение объема тензора (Overflow) */<text:line-break/> <text:s text:c="7"/>}<text:line-break/> <text:s text:c="7"/><text:line-break/> <text:s text:c="7"/>ctx.current_stride *= dim_size;<text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>*pOutFlatIndex = ctx.flat_index;<text:line-break/> <text:s text:c="3"/>return 0; /* Успешно */<text:line-break/>}</text:span><text:line-break/></text:p>
   <text:p text:style-name="P84"/>
   <text:p text:style-name="P84"/>
   <text:p text:style-name="P84"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P75" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 2 Copy 1"/><text:span text:style-name="T40">8</text:span><text:span text:style-name="T41">. ОСОБЕННОСТИ АДРЕСАЦИИ ДЛЯ СХЕМЫ SIMPLE_HDR</text:span> <text:bookmark-end text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 2 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P76"/>
   <text:p text:style-name="P93">Если в <text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">hdr.flags</text:span></text:span> установлен признак облегченного бинарного файла <text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_FLAG_SIMPLE_HDR</text:span></text:span>, алгоритм расчета линеаризации в оперативной памяти <text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T26">не изменяется</text:span></text:span>. Рантайм-дескриптор <text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_RUNTIME_TENSOR_V1_T</text:span></text:span> всегда разворачивает указатели <text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">shape_ptr</text:span></text:span> и <text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">data_ptr</text:span></text:span> в плоские Си-массивы независимо от того, какая бинарная структура (8 или 16 байт) была прочитана с диска. Это гарантирует полную инвариантность и одинаковую тактовую скорость работы математических ядер. <text:s/></text:p>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P75" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="T40">9</text:span><text:span text:style-name="T41">. СТРУКТУРА БИНАРНОГО ФАЙЛА И ПРАВИЛА СЕРИАЛИЗАЦИИ</text:span><text:bookmark-end text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P76"/>
   <text:list xml:id="list160915179286684" text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P87" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1"/>9.<text:span text:style-name="T53">1</text:span>. <text:s/>Общая топология бинарного образа<text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P91">Бинарный файл EcoTensor представляет собой монолитный последовательный байтовый поток. В зависимости от установленных системных флагов файл формируется в одной из двух дисковых конфигураций:</text:p>
   <text:list text:style-name="L8">
    <text:list-item>
     <text:p text:style-name="P94"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Полная дисковая конфигурация (Full Layout):</text:span></text:span><text:span text:style-name="T50"> включает 16-байтовый заголовок </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_V1_T</text:span></text:span><text:span text:style-name="T50"> (содержит маркер </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">magic</text:span></text:span><text:span text:style-name="T50"> и </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ref_count</text:span></text:span><text:span text:style-name="T50">).</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P94"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Облегченная дисковая конфигурация (Simple Layout):</text:span></text:span><text:span text:style-name="T50"> включает 8-байтовый заголовок </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_SIMPLE_TENSOR_V1_T</text:span></text:span><text:span text:style-name="T50"> (используется при взведенном флаге </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_FLAG_SIMPLE_HDR</text:span></text:span><text:span text:style-name="T50">).</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P95">Независимо от конфигурации, физический образ файла состоит из четырех последовательных блоков:</text:p>
   <text:p text:style-name="P96"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">┌───────────────────────────────────────────────────────────────────┐</text:span></text:span></text:p>
   <text:p text:style-name="P97"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">│ <text:s/></text:span></text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T55">БЛОК 1: Бинарный заголовок метаданных (Размер: 8 или 16 Б) <text:s text:c="6"/>│</text:span></text:span></text:p>
   <text:p text:style-name="P98"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">├───────────────────────────────────────────────────────────────────┤</text:span></text:span></text:p>
   <text:p text:style-name="P97"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">│ <text:s/></text:span></text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T55">БЛОК 2: Паддинг выравнивания геометрии (Динамический размер) <text:s text:c="4"/>│</text:span></text:span></text:p>
   <text:p text:style-name="P98"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">├───────────────────────────────────────────────────────────────────┤</text:span></text:span></text:p>
   <text:p text:style-name="P97"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">│ <text:s/></text:span></text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T55">БЛОК 3: Массив геометрии SHAPE (Размер: ndims * shape_size) <text:s text:c="5"/>│</text:span></text:span></text:p>
   <text:p text:style-name="P98"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">├───────────────────────────────────────────────────────────────────┤</text:span></text:span></text:p>
   <text:p text:style-name="P97"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">│ <text:s/></text:span></text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T55">БЛОК 4: Паддинг выравнивания данных (Динамический размер) <text:s text:c="7"/>│</text:span></text:span></text:p>
   <text:p text:style-name="P98"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">├───────────────────────────────────────────────────────────────────┤</text:span></text:span></text:p>
   <text:p text:style-name="P97"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">│ <text:s/></text:span></text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T55">БЛОК 5: Полезная нагрузка DATA (Плотный или разреженный) <text:s text:c="8"/>│</text:span></text:span></text:p>
   <text:p text:style-name="P98"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T54">└───────────────────────────────────────────────────────────────────┘</text:span></text:span></text:p>
   <text:list text:continue-list="list160915179286684" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P87" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 1"/>9.2. <text:s/>Математический расчет динамических паддингов (Padding)<text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P91">Для предотвращения сбоев аппаратной шины процессора (Misaligned Access) при чтении файла методом <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">mmap</text:span></text:span> (Memory Map), каждый блок данных внутри файла должен начинаться со смещения, кратного его индивидуальному правилу выравнивания.</text:p>
   <text:p text:style-name="P29">Пусть \(H_{\text{size}}\) — физический размер выбранного заголовка (8 или 16 байт).<text:line-break/>Размер одного элемента осей равен \(A_{\text{shape}} = 1 \ll \text{shape\_type}\).<text:line-break/>Требуемое выравнивание осей равно \(W_{\text{shape}} = 1 \ll \text{shape\_align}\).<text:line-break/>Размер буфера геометрии равен \(V_{\text{shape}} = \text{ndims} \times A_{\text{shape}}\).<text:line-break/>Требуемое выравнивание полезных данных равно \(W_{\text{data}} = 1 \ll \text{data\_align}\).</text:p>
   <text:p text:style-name="P89"><text:span text:style-name="T25">Смещение начала блока геометрии </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">SHAPE</text:span></text:span><text:span text:style-name="T25"> в файле (\(Offset_{\text{shape}}\)) вычисляется по формуле:</text:span></text:p>
   <text:p text:style-name="P29">\(Offset_{\text{shape}}=(H_{\text{size}}+(W_{\text{shape}}-1))\ \&amp;\ \sim (W_{\text{shape}}-1)\)</text:p>
   <text:p text:style-name="P89"><text:soft-page-break/><text:span text:style-name="T25">Смещение начала блока полезных данных </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">DATA</text:span></text:span><text:span text:style-name="T25"> в файле (\(Offset_{\text{data}}\)) вычисляется по формуле:</text:span></text:p>
   <text:p text:style-name="P29">\(Offset_{\text{data}}=((Offset_{\text{shape}}+V_{\text{shape}})+(W_{\text{data}}-1))\ \&amp;\ \sim (W_{\text{data}}-1)\)</text:p>
   <text:p text:style-name="P89"><text:span text:style-name="Emphasis"><text:span text:style-name="T25">Все промежуточные байты паддингов между блоками при записи на диск обязаны принудительно заполняться нулями (</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">0x00</text:span></text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T25">) для обеспечения воспроизводимости бинарных хэш-сумм (MD5/SHA-256) файлов.</text:span></text:span></text:p>
   <text:p text:style-name="P91"/>
   <text:p text:style-name="P91"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P75" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="T40">10</text:span><text:span text:style-name="T41">. АЛГОРИТМ ЧТЕНИЯ И СЕРИАЛИЗАЦИИ ФАЙЛА НА СИ (C89)</text:span><text:bookmark-end text:name="__RefHeading___Toc72889_228845717 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P76"/>
   <text:list text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P87" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 2"/>10.<text:span text:style-name="T53">1</text:span>. <text:s/>Сервисный метод сериализации (Сохранение на диск)<text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 2"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P91">Ниже представлен промышленный алгоритм записи пассивного рантайм-тензора в дисковый поток. Функция автоматически определяет целевой формат заголовка на основе флагов дескриптора и генерирует выровненный бинарный дамп.</text:p>
   <text:p text:style-name="P91"/>
   <text:p text:style-name="P66">#include &lt;stdio.h&gt;<text:line-break/>#include &lt;string.h&gt;<text:line-break/><text:line-break/>/* Вспомогательный локальный метод записи байт паддинга */<text:line-break/>static int16_t _EcoTensor_WriteZeroPadding(FILE* pFile, size_t count) {<text:line-break/> <text:s text:c="3"/>size_t i;<text:line-break/> <text:s text:c="3"/>uint8_t zero = 0x00;<text:line-break/> <text:s text:c="3"/>for (i = 0; i &lt; count; i++) {<text:line-break/> <text:s text:c="7"/>if (fwrite(&amp;zero, 1, 1, pFile) != 1) return -201; /* Ошибка записи на диск */<text:line-break/> <text:s text:c="3"/>}<text:line-break/> <text:s text:c="3"/>return 0;<text:line-break/>}<text:line-break/><text:line-break/>int16_t ECOCALLMETHOD EcoTensorEngine1_Serialize(<text:line-break/> <text:s text:c="3"/>IEcoTensorEngine1Ptr_t me, <text:line-break/> <text:s text:c="3"/>const ECO_RUNTIME_TENSOR_V1_T* pTensor, <text:line-break/> <text:s text:c="3"/>voidptr_t file_handle,<text:line-break/> <text:s text:c="3"/>uint64_t* pOutBytesWritten<text:line-break/>) {<text:line-break/> <text:s text:c="3"/>FILE* f = (FILE*)file_handle;<text:line-break/> <text:s text:c="3"/>size_t current_offset = 0;<text:line-break/> <text:s text:c="3"/>size_t target_offset = 0;<text:line-break/> <text:s text:c="3"/>size_t shape_bytes = 0;<text:line-break/> <text:s text:c="3"/>size_t data_bytes = 0;<text:line-break/> <text:s text:c="3"/>int16_t status;<text:line-break/><text:line-break/> <text:s text:c="3"/>if (!pTensor || !f || !pOutBytesWritten) return -2147467261; /* E_POINTER */<text:line-break/> <text:s text:c="3"/>*pOutBytesWritten = 0;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* 1. Запись выбранного бинарного заголовка */<text:line-break/> <text:s text:c="3"/>if (pTensor-&gt;hdr.flags &amp; ECO_TENSOR_FLAG_SIMPLE_HDR) {<text:line-break/> <text:s text:c="7"/>/* Формируем временный усеченный заголовок на стеке */<text:line-break/> <text:s text:c="7"/>ECO_SIMPLE_TENSOR_V1_T simple_hdr;<text:line-break/> <text:s text:c="7"/>simple_hdr.ndims = pTensor-&gt;hdr.ndims;<text:line-break/> <text:s text:c="7"/>simple_hdr.flags = pTensor-&gt;hdr.flags;<text:line-break/> <text:s text:c="7"/>simple_hdr.data_type = pTensor-&gt;hdr.data_type;<text:line-break/> <text:s text:c="7"/>simple_hdr.shape_type = pTensor-&gt;hdr.shape_type;<text:line-break/> <text:s text:c="7"/>simple_hdr.data_align = pTensor-&gt;hdr.data_align;<text:line-break/> <text:s text:c="7"/>simple_hdr.shape_align = pTensor-&gt;hdr.shape_align;<text:line-break/><text:line-break/> <text:s text:c="7"/>if (fwrite(&amp;simple_hdr, 1, 8, f) != 8) return -202;<text:line-break/> <text:s text:c="7"/>current_offset = 8;<text:line-break/> <text:s text:c="3"/>} else {<text:line-break/> <text:s text:c="7"/>/* Пишем полный 16-байтовый заголовок дескриптора */<text:line-break/> <text:s text:c="7"/>if (fwrite(&amp;(pTensor-&gt;hdr), 1, 16, f) != 16) return -202;<text:line-break/> <text:s text:c="7"/>current_offset = 16;<text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>/* 2. Расчет и запись паддинга блока SHAPE */<text:line-break/> <text:s text:c="3"/>size_t w_shape = 1 &lt;&lt; pTensor-&gt;hdr.shape_align;<text:line-break/> <text:s text:c="3"/>target_offset = (current_offset + (w_shape - 1)) &amp; ~(w_shape - 1);<text:line-break/> <text:s text:c="3"/>if ((status = _EcoTensor_WriteZeroPadding(f, target_offset - current_offset)) != 0) return status;<text:line-break/> <text:s text:c="3"/>current_offset = target_offset;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* 3. Запись массива геометрии SHAPE */<text:line-break/> <text:s text:c="3"/>shape_bytes = (size_t)pTensor-&gt;hdr.ndims * (1 &lt;&lt; pTensor-&gt;hdr.shape_type);<text:line-break/> <text:s text:c="3"/>if (fwrite(pTensor-&gt;shape_ptr, 1, shape_bytes, f) != shape_bytes) return -203;<text:line-break/> <text:s text:c="3"/>current_offset += shape_bytes;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* 4. Расчет и запись паддинга блока DATA */<text:line-break/> <text:s text:c="3"/>size_t w_data = 1 &lt;&lt; pTensor-&gt;hdr.data_align;<text:line-break/><text:soft-page-break/> <text:s text:c="3"/>target_offset = (current_offset + (w_data - 1)) &amp; ~(w_data - 1);<text:line-break/> <text:s text:c="3"/>if ((status = _EcoTensor_WriteZeroPadding(f, target_offset - current_offset)) != 0) return status;<text:line-break/> <text:s text:c="3"/>current_offset = target_offset;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* 5. Запись полезной нагрузки DATA (В рамках V1 рассматривается DENSE формат) */<text:line-break/> <text:s text:c="3"/>data_bytes = EcoTensor_GetVolume(ECO_GET_SIMPLE_HDR_PTR(&amp;(pTensor-&gt;hdr)), pTensor-&gt;shape_ptr) * <text:line-break/> <text:s text:c="16"/>EcoTensor_GetDataTypeSize(pTensor-&gt;hdr.data_type);<text:line-break/> <text:s text:c="16"/><text:line-break/> <text:s text:c="3"/>if (fwrite(pTensor-&gt;data_ptr, 1, data_bytes, f) != data_bytes) return -204;<text:line-break/> <text:s text:c="3"/>current_offset += data_bytes;<text:line-break/><text:line-break/> <text:s text:c="3"/>*pOutBytesWritten = (uint64_t)current_offset;<text:line-break/> <text:s text:c="3"/>return 0; /* Успешное завершение сериализации */<text:line-break/>}<text:line-break/></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P91"/>
   <text:list xml:id="list160915431823836" text:continue-numbering="true" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P87" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 2 Copy 1"/>10.2. <text:s/>Особенности десериализации (Парсинг структуры «на лету»)<text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 2 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P78"/>
   <text:p text:style-name="P91">При чтении бинарного файла с диска сервисный движок обязан выполнить атомарную валидацию первого байта физической последовательности потока. Потенциальный алгоритм десериализации включает в себя следующие шаги проверки:</text:p>
   <text:list text:style-name="L9">
    <text:list-item>
     <text:p text:style-name="P99"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Чтение первичного блока метаданных:</text:span></text:span><text:span text:style-name="T50"> ядро считывает первые 8 байт файла в буфер </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_SIMPLE_TENSOR_V1_T</text:span></text:span><text:span text:style-name="T50">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P100"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Диспетчеризация типа файла:</text:span></text:span></text:p>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P99"><text:span text:style-name="T50">Если в поле </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">flags</text:span></text:span><text:span text:style-name="T50"> </text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">отсутствует</text:span></text:span><text:span text:style-name="T50"> бит </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_FLAG_SIMPLE_HDR</text:span></text:span><text:span text:style-name="T50">, рантайм интерпретирует буфер как верхнюю половину полной структуры </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_V1_T</text:span></text:span><text:span text:style-name="T50">. Сервис дочитывает из файла еще 8 байт для восстановления полей </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">magic</text:span></text:span><text:span text:style-name="T50"> и </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ref_count</text:span></text:span><text:span text:style-name="T50">, после чего производит валидацию </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">magic</text:span></text:span><text:span text:style-name="T50"> на соответствие Endianness текущей аппаратной платформы.</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P99"><text:span text:style-name="T50">Если бит </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_FLAG_SIMPLE_HDR</text:span></text:span><text:span text:style-name="T50"> </text:span><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">взведен</text:span></text:span><text:span text:style-name="T50">, дочитка не производится. Рантайм переходит в режим Simple Layout, а поля </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">magic</text:span></text:span><text:span text:style-name="T50"> и </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ref_count</text:span></text:span><text:span text:style-name="T50"> внутри дескриптора оперативной памяти инициализируются нулевыми значениями.</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P99"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Восстановление указателей:</text:span></text:span><text:span text:style-name="T50"> На основе формул из раздела 9.2 рассчитываются точные позиции файловых указателей (</text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">fseek</text:span></text:span><text:span text:style-name="T50">), после чего массивы </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">shape_ptr</text:span></text:span><text:span text:style-name="T50"> и </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">data_ptr</text:span></text:span><text:span text:style-name="T50"> считываются в оперативную память хоста за две транзакции ввода-вывода (либо мапятся через </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">mmap</text:span></text:span><text:span text:style-name="T50"> за одну транзакцию).</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P91"/>
   <text:p text:style-name="P91"/>
   <text:p text:style-name="P91"/>
   <text:list xml:id="list160916010491593" text:continue-list="list160915431823836" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P101" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 2 Copy 1 Copy 1"/>10.<text:span text:style-name="T56">3</text:span>. <text:s/>Сервисный метод сериализации модели с числовым CBOR-паспортом<text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 2 Copy 1 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P102"/>
   <text:p text:style-name="P103">Метод кодирует ультракомпактный числовой CBOR-паспорт (размером 27 байт для двух тензоров) прямо на стеке процессора без динамических аллокаций. Алгоритм автоматически рассчитывает сквозное смещение каждого тензора с учетом аппаратных требований <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">data_align</text:span></text:span> и <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">shape_align</text:span></text:span>, формирует единый дисковый <text:soft-page-break/>образ и выравнивает физическое начало пула тензоров по границе 64 байт (кэш-лайн) [local].</text:p>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="code_5f_cpp"><text:span text:style-name="T52">#include &lt;stdio.h&gt;<text:line-break/>#include &lt;stdint.h&gt;<text:line-break/>#include &lt;string.h&gt;<text:line-break/><text:line-break/>/* Вспомогательный локальный метод записи байт паддинга */<text:line-break/>static int16_t _EcoTensor_WriteZeroPadding(FILE* pFile, size_t count) {<text:line-break/> <text:s text:c="3"/>size_t i;<text:line-break/> <text:s text:c="3"/>uint8_t zero = 0x00;<text:line-break/> <text:s text:c="3"/>for (i = 0; i &lt; count; i++) {<text:line-break/> <text:s text:c="7"/>if (fwrite(&amp;zero, 1, 1, pFile) != 1) return -201; /* Ошибка записи */<text:line-break/> <text:s text:c="3"/>}<text:line-break/> <text:s text:c="3"/>return 0;<text:line-break/>}<text:line-break/><text:line-break/>/**<text:line-break/> * Сервисный метод формирования и записи файла модели (.etm) с числовым CBOR-паспортом.<text:line-break/> * Поддерживает сериализацию двух тензоров (matrix_A и matrix_B).<text:line-break/> */<text:line-break/>int16_t ECOCALLMETHOD EcoTensorEngine1_SaveModelV1(<text:line-break/> <text:s text:c="3"/>IEcoTensorEngine1Ptr_t me,<text:line-break/> <text:s text:c="3"/>const ECO_RUNTIME_TENSOR_V1_T* pTensorA, <text:s/>/* ID: 101 */<text:line-break/> <text:s text:c="3"/>const ECO_RUNTIME_TENSOR_V1_T* pTensorB, <text:s/>/* ID: 102 */<text:line-break/> <text:s text:c="3"/>voidptr_t file_handle,<text:line-break/> <text:s text:c="3"/>uint64_t* pOutBytesWritten<text:line-break/>) {<text:line-break/> <text:s text:c="3"/>FILE* f = (FILE*)file_handle;<text:line-break/> <text:s text:c="3"/>uint8_t cbor[64]; /* Статический буфер на стеке для числового CBOR */<text:line-break/> <text:s text:c="3"/>size_t cbor_p = 0;<text:line-break/> <text:s text:c="3"/>size_t current_offset = 0;<text:line-break/> <text:s text:c="3"/>size_t target_offset = 0;<text:line-break/> <text:s text:c="3"/>size_t t1_total_bytes = 0;<text:line-break/> <text:s text:c="3"/>size_t t2_total_bytes = 0;<text:line-break/> <text:s text:c="3"/>uint32_t t2_pool_offset = 0;<text:line-break/> <text:s text:c="3"/>int16_t status;<text:line-break/><text:line-break/> <text:s text:c="3"/>if (!pTensorA || !pTensorB || !f || !pOutBytesWritten) return -2147467261; /* E_POINTER */<text:line-break/> <text:s text:c="3"/>*pOutBytesWritten = 0;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="2"/>1. РАСЧЕТ СМЕЩЕНИЯ ВТОРОГО ТЕНЗОРА В ПУЛЕ (С УЧЕТОМ ВЫРАВНИВАНИЙ) <text:s text:c="7"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* Вычисляем физический размер первого тензора на диске: заголовок + shape + данные */<text:line-break/> <text:s text:c="3"/>size_t t1_hdr_size <text:s text:c="2"/>= (pTensorA-&gt;hdr.flags &amp; ECO_TENSOR_FLAG_SIMPLE_HDR) ? 8 : 16;<text:line-break/> <text:s text:c="3"/>size_t t1_shape_align = 1 &lt;&lt; pTensorA-&gt;hdr.shape_align;<text:line-break/> <text:s text:c="3"/>size_t t1_data_align <text:s/>= 1 &lt;&lt; pTensorA-&gt;hdr.data_align;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>size_t t1_shape_start = (t1_hdr_size + (t1_shape_align - 1)) &amp; ~(t1_shape_align - 1);<text:line-break/> <text:s text:c="3"/>size_t t1_shape_bytes = (size_t)pTensorA-&gt;hdr.ndims * (1 &lt;&lt; pTensorA-&gt;hdr.shape_type);<text:line-break/> <text:s text:c="3"/>size_t t1_shape_end <text:s text:c="2"/>= t1_shape_start + t1_shape_bytes;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>size_t t1_data_start <text:s/>= (t1_shape_end + (t1_data_align - 1)) &amp; ~(t1_data_align - 1);<text:line-break/> <text:s text:c="3"/>size_t t1_data_bytes <text:s/>= EcoTensor_GetVolume(ECO_GET_SIMPLE_HDR_PTR(&amp;(pTensorA-&gt;hdr)), pTensorA-&gt;shape_ptr) * <text:line-break/> <text:s text:c="27"/>EcoTensor_GetDataTypeSize(pTensorA-&gt;hdr.data_type);<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>t1_total_bytes = t1_data_start + t1_data_bytes;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Смещение второго тензора в пуле обязано быть выровнено по кэш-лайну (64 байта) */<text:line-break/> <text:s text:c="3"/>t2_pool_offset = (uint32_t)((t1_total_bytes + 63) &amp; ~63);<text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="2"/>2. РУЧНОЕ КОДИРОВАНИЕ СВЕРХКОМПАКТНОГО ЧИСЛОВОГО CBOR (27 БАЙТ) <text:s text:c="9"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0xA2; /* Корневой Map из 2-х элементов */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x00; /* Ключ: 0 (MODEL_TYPE_ID) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x00; /* Значение: 0 (Одиночные тензоры общего назначения) */<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x01; /* Ключ: 1 (TENSORS_MAP) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0xA2; /* Значение: Map из 2-х элементов (Словарь тензоров) */<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>/* --- Описание Тензора 1 (ID 101) --- */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x18; cbor[cbor_p++] = 101; <text:s/>/* Ключ-ID: Число 101 (matrix_A) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0xA2; <text:s text:c="24"/>/* Свойства тензора 1 (Map из 2 элементов) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x00; cbor[cbor_p++] = 0x00; <text:s/>/* Ключ 0 (OFFSET) -&gt; Значение: 0 */<text:line-break/></text:span><text:soft-page-break/><text:span text:style-name="T52"> <text:s text:c="3"/>cbor[cbor_p++] = 0x01; <text:s text:c="24"/>/* Ключ 1 (TENSOR_ID) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x18; cbor[cbor_p++] = 101; <text:s/>/* Значение: 101 */<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>/* --- Описание Тензора 2 (ID 102) --- */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x18; cbor[cbor_p++] = 102; <text:s/>/* Ключ-ID: Число 102 (matrix_B) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0xA2; <text:s text:c="24"/>/* Свойства тензора 2 (Map из 2 элементов) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x00; <text:s text:c="24"/>/* Ключ 0 (OFFSET) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x1A; <text:s text:c="24"/>/* Значение: Major Type 0 (маркер 26 -&gt; 4 байта) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = (uint8_t)((t2_pool_offset &gt;&gt; 24) &amp; 0xFF);<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = (uint8_t)((t2_pool_offset &gt;&gt; 16) &amp; 0xFF);<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = (uint8_t)((t2_pool_offset &gt;&gt; 8) &amp; 0xFF);<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = (uint8_t)(t2_pool_offset &amp; 0xFF); /* Запись вычисленного смещения 40 000 064 */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x01; <text:s text:c="24"/>/* Ключ 1 (TENSOR_ID) */<text:line-break/> <text:s text:c="3"/>cbor[cbor_p++] = 0x18; cbor[cbor_p++] = 102; <text:s/>/* Значение: 102 */<text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="2"/>3. ПОСЛЕДОВАТЕЛЬНЫЙ ВЫВОД БЛОКОВ ФАЙЛА НА ДИСК <text:s text:c="25"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* Шаг 3.1: Запись 8-байтового системного префикса */<text:line-break/> <text:s text:c="3"/>if (fwrite(&quot;ETM1&quot;, 1, 4, f) != 4) return -202;<text:line-break/> <text:s text:c="3"/>uint32_t cbor_size_le = (uint32_t)cbor_p; /* Предполагаем LE нативную систему */<text:line-break/> <text:s text:c="3"/>if (fwrite(&amp;cbor_size_le, 1, 4, f) != 4) return -202;<text:line-break/> <text:s text:c="3"/>current_offset = 8;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Шаг 3.2: Запись CBOR-паспорта */<text:line-break/> <text:s text:c="3"/>if (fwrite(cbor, 1, cbor_p, f) != cbor_p) return -203;<text:line-break/> <text:s text:c="3"/>current_offset += cbor_p;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Шаг 3.3: Выравнивание начала пула тензоров по границе 64 байт (кэш-лайн) */<text:line-break/> <text:s text:c="3"/>target_offset = (current_offset + 63) &amp; ~63;<text:line-break/> <text:s text:c="3"/>if ((status = _EcoTensor_WriteZeroPadding(f, target_offset - current_offset)) != 0) return status;<text:line-break/> <text:s text:c="3"/>current_offset = target_offset; /* Пул начнется строго с байта 64 */<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Шаг 3.4: ЗАПИСЬ ПЕРВОВГО ТЕНЗОРНОГО БЛОКА (matrix_A) */<text:line-break/> <text:s text:c="3"/>/* Запись структуры заголовка */<text:line-break/> <text:s text:c="3"/>if (fwrite(&amp;(pTensorA-&gt;hdr), 1, t1_hdr_size, f) != t1_hdr_size) return -204;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>/* Паддинг до shape */<text:line-break/> <text:s text:c="3"/>if ((status = _EcoTensor_WriteZeroPadding(f, t1_shape_start - t1_hdr_size)) != 0) return status;<text:line-break/> <text:s text:c="3"/>/* Запись shape */<text:line-break/> <text:s text:c="3"/>if (fwrite(pTensorA-&gt;shape_ptr, 1, t1_shape_bytes, f) != t1_shape_bytes) return -205;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>/* Паддинг до data */<text:line-break/> <text:s text:c="3"/>if ((status = _EcoTensor_WriteZeroPadding(f, t1_data_start - t1_shape_end)) != 0) return status;<text:line-break/> <text:s text:c="3"/>/* Запись data */<text:line-break/> <text:s text:c="3"/>if (fwrite(pTensorA-&gt;data_ptr, 1, t1_data_bytes, f) != t1_data_bytes) return -206;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>/* Выравнивающий паддинг между тензорами до границы кэш-лайна */<text:line-break/> <text:s text:c="3"/>size_t written_so_far = t1_total_bytes;<text:line-break/> <text:s text:c="3"/>size_t next_tensor_target = (written_so_far + 63) &amp; ~63;<text:line-break/> <text:s text:c="3"/>if ((status = _EcoTensor_WriteZeroPadding(f, next_tensor_target - written_so_far)) != 0) return status;<text:line-break/><text:line-break/> <text:s text:c="3"/>current_offset += next_tensor_target; /* Перешли на смещение 40 000 128 в файле */<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Шаг 3.5: ЗАПИСЬ ВТОРОГО ТЕНЗОРНОГО БЛОКА (matrix_B) */<text:line-break/> <text:s text:c="3"/>size_t t2_hdr_size <text:s text:c="3"/>= (pTensorB-&gt;hdr.flags &amp; ECO_TENSOR_FLAG_SIMPLE_HDR) ? 8 : 16;<text:line-break/> <text:s text:c="3"/>size_t t2_shape_align = 1 &lt;&lt; pTensorB-&gt;hdr.shape_align;<text:line-break/> <text:s text:c="3"/>size_t t2_data_align <text:s/>= 1 &lt;&lt; pTensorB-&gt;hdr.data_align;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>size_t t2_shape_start = (t2_hdr_size + (t2_shape_align - 1)) &amp; ~(t2_shape_align - 1);<text:line-break/> <text:s text:c="3"/>size_t t2_shape_bytes = (size_t)pTensorB-&gt;hdr.ndims * (1 &lt;&lt; pTensorB-&gt;hdr.shape_type);<text:line-break/> <text:s text:c="3"/>size_t t2_shape_end <text:s text:c="2"/>= t2_shape_start + t2_shape_bytes;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>size_t t2_data_start <text:s/>= (t2_shape_end + (t2_data_align - 1)) &amp; ~(t2_data_align - 1);<text:line-break/> <text:s text:c="3"/>size_t t2_data_bytes <text:s/>= EcoTensor_GetVolume(ECO_GET_SIMPLE_HDR_PTR(&amp;(pTensorB-&gt;hdr)), pTensorB-&gt;shape_ptr) * <text:line-break/> <text:s text:c="27"/>EcoTensor_GetDataTypeSize(pTensorB-&gt;hdr.data_type);<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Запись структуры заголовка */<text:line-break/> <text:s text:c="3"/>if (fwrite(&amp;(pTensorB-&gt;hdr), 1, t2_hdr_size, f) != t2_hdr_size) return -207;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>/* Паддинг до shape */<text:line-break/> <text:s text:c="3"/>if ((status = _EcoTensor_WriteZeroPadding(f, t2_shape_start - t2_hdr_size)) != 0) return status;<text:line-break/> <text:s text:c="3"/>/* Запись shape */<text:line-break/> <text:s text:c="3"/>if (fwrite(pTensorB-&gt;shape_ptr, 1, t2_shape_bytes, f) != t2_shape_bytes) return -208;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>/* Паддинг до data */<text:line-break/></text:span><text:soft-page-break/><text:span text:style-name="T52"> <text:s text:c="3"/>if ((status = _EcoTensor_WriteZeroPadding(f, t2_data_start - t2_shape_end)) != 0) return status;<text:line-break/> <text:s text:c="3"/>/* Запись data */<text:line-break/> <text:s text:c="3"/>if (fwrite(pTensorB-&gt;data_ptr, 1, t2_data_bytes, f) != t2_data_bytes) return -209;<text:line-break/><text:line-break/> <text:s text:c="3"/>current_offset += t2_data_start + t2_data_bytes;<text:line-break/><text:line-break/> <text:s text:c="3"/>*pOutBytesWritten = (uint64_t)current_offset;<text:line-break/> <text:s text:c="3"/>return 0; /* Успешное сохранение всей модели */<text:line-break/>}</text:span><text:line-break/></text:p>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="P104">Архитектурные преимущества алгоритма 10.3:</text:p>
   <text:list text:style-name="L10">
    <text:list-item>
     <text:p text:style-name="P105"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Динамический расчет смещений без хардкода:</text:span></text:span><text:span text:style-name="T50"> Сервис самостоятельно сканирует </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">shape_ptr</text:span></text:span><text:span text:style-name="T50"> и математические типы первого тензора, определяя его точный дисковый след со всеми паддингами. Значение смещения для второго тензора формируется &quot;на лету&quot; и записывается в 4 байта CBOR-токена (</text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">0x1A</text:span></text:span><text:span text:style-name="T50">), полностью избавляя разработчика от ручного ведения карт смещений.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P105"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Нулевой оверхед по памяти (Zero Heap Memory Allocation):</text:span></text:span><text:span text:style-name="T50"> Метод не использует </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">malloc</text:span></text:span><text:span text:style-name="T50"> для сборки бинарного CBOR-паспорта. Дерево токенов последовательно укладывается в фиксированный массив на аппаратном стеке, что предотвращает фрагментацию памяти рантайма при частой перезаписи моделей.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P105"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Строгая сквозная выровненность:</text:span></text:span><text:span text:style-name="T50"> Блоки паддингов гарантируют, что и первый заголовок </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">ECO_TENSOR_V1_T</text:span></text:span><text:span text:style-name="T50"> (байт 64), и второй заголовок (байт 40 000 128), и массивы их элементов </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">DATA</text:span></text:span><text:span text:style-name="T50"> займут позиции, идеально кратные физической строке кэша процессора.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="P103"/>
   <text:list text:continue-list="list160916010491593" text:style-name="L1">
    <text:list-header>
     <text:h text:style-name="P101" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1"/>10.<text:span text:style-name="T56">4</text:span>. <text:s/>Сервисный метод десериализации модели с числовым CBOR-паспортом<text:bookmark-end text:name="__RefHeading___Toc72879_228845717 Copy 1 Copy 1 Copy 2 Copy 2 Copy 3 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1"/></text:h>
    </text:list-header>
   </text:list>
   <text:p text:style-name="P102"/>
   <text:p text:style-name="P103">Метод выполняет парсинг ультракомпактного числового CBOR-паспорта за один проход по бинарному потоку. Алгоритм не производит динамических аллокаций памяти под данные, а вычисляет абсолютные смещения внутри проецируемого в память файла (<text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">mmap</text:span></text:span>), мгновенно инициализируя рантайм-дескрипторы <text:span text:style-name="Source_20_Text"><text:span text:style-name="T48">ECO_RUNTIME_TENSOR_V1_T</text:span></text:span> со скоростью работы кэш-линий процессора.</text:p>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="P66">#include &lt;stdint.h&gt;<text:line-break/>#include &lt;string.h&gt;<text:line-break/><text:line-break/>/**<text:line-break/> * Внутренний вспомогательный метод быстрого поиска смещения тензора по числовому ID.<text:line-break/> * cbor_buf - указатель на начало CBOR-паспорта в памяти.<text:line-break/> * target_id - искомый ID (101 или 102).<text:line-break/> * pOutOffset - возвращаемое относительное смещение тензора внутри пула.<text:line-break/> */<text:line-break/>static int16_t _EcoTensor_FindOffsetInCbor(const uint8_t* cbor_buf, uint16_t target_id, uint32_t* pOutOffset) {<text:line-break/> <text:s text:c="3"/>/* 1. Базовая валидация корневого словаря (ожидаем Map из 2-х элементов) */<text:line-break/> <text:s text:c="3"/>if (cbor_buf[0] != 0xA2 || cbor_buf[1] != 0x00 || cbor_buf[2] != 0x00) return -501;<text:line-break/> <text:s text:c="3"/>if (cbor_buf[3] != 0x01) return -502;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>/* 2. Читаем количество тензоров в словаре (выделяем младшие 5 бит из байта Map) */<text:line-break/> <text:s text:c="3"/>uint8_t num_tensors = cbor_buf[4] &amp; 0x1F; <text:line-break/> <text:s text:c="3"/>size_t p = 5; /* Указатель текущей позиции парсинга потока */<text:line-break/> <text:s text:c="3"/>uint8_t t;<text:line-break/><text:line-break/><text:soft-page-break/> <text:s text:c="3"/>/* 3. Сканируем числовую карту тензоров */<text:line-break/> <text:s text:c="3"/>for (t = 0; t &lt; num_tensors; t++) {<text:line-break/> <text:s text:c="7"/>/* Читаем маркер ID тензора (ожидаем 0x18 + 1 байт значения) */<text:line-break/> <text:s text:c="7"/>if (cbor_buf[p] != 0x18) return -503;<text:line-break/> <text:s text:c="7"/>uint16_t current_id = cbor_buf[p + 1];<text:line-break/> <text:s text:c="7"/><text:line-break/> <text:s text:c="7"/>if (cbor_buf[p + 2] != 0xA2) return -504; /* Ожидаем свойства тензора (Map из 2 пар) */<text:line-break/><text:line-break/> <text:s text:c="7"/>if (current_id == target_id) {<text:line-break/> <text:s text:c="11"/>/* Целевой тензор найден. Проверяем ключ TENSOR_OFFSET (0x00) */<text:line-break/> <text:s text:c="11"/>if (cbor_buf[p + 3] == 0x00) {<text:line-break/> <text:s text:c="15"/>uint8_t marker = cbor_buf[p + 4];<text:line-break/> <text:s text:c="15"/>if (marker == 0x00) {<text:line-break/> <text:s text:c="19"/>*pOutOffset = 0; /* Первый тензор, смещение строго 0 */<text:line-break/> <text:s text:c="19"/>return 0;<text:line-break/> <text:s text:c="15"/>} else if (marker == 0x1A) { /* Второстепенный тензор, смещение занимает 4 байта */<text:line-break/> <text:s text:c="19"/>/* Сборка uint32_t из Big-Endian потока CBOR */<text:line-break/> <text:s text:c="19"/>uint32_t offset = ((uint32_t)cbor_buf[p + 5] &lt;&lt; 24) |<text:line-break/> <text:s text:c="37"/>((uint32_t)cbor_buf[p + 6] &lt;&lt; 16) |<text:line-break/> <text:s text:c="37"/>((uint32_t)cbor_buf[p + 7] &lt;&lt; 8) <text:s/>|<text:line-break/> <text:s text:c="37"/>((uint32_t)cbor_buf[p + 8]);<text:line-break/> <text:s text:c="19"/>*pOutOffset = offset;<text:line-break/> <text:s text:c="19"/>return 0; /* Смещение успешно получено */<text:line-break/> <text:s text:c="15"/>}<text:line-break/> <text:s text:c="11"/>}<text:line-break/> <text:s text:c="7"/>}<text:line-break/> <text:s text:c="7"/><text:line-break/> <text:s text:c="7"/>/* Сдвиг указателя парсера на следующий элемент в зависимости от размера типа смещения */<text:line-break/> <text:s text:c="7"/>p += (cbor_buf[p + 4] == 0x1A) ? 12 : 8; <text:line-break/> <text:s text:c="3"/>}<text:line-break/><text:line-break/> <text:s text:c="3"/>return -505; /* Ошибка: Тензор с указанным ID не найден в паспорте */<text:line-break/>}<text:line-break/><text:line-break/>/**<text:line-break/> * Сервисный метод десериализации модели из mmap-памяти.<text:line-break/> * Инициализирует два рантайм-дескриптора на основе числового CBOR-паспорта.<text:line-break/> */<text:line-break/>int16_t ECOCALLMETHOD EcoTensorEngine1_LoadModelV1(<text:line-break/> <text:s text:c="3"/>IEcoTensorEngine1Ptr_t me,<text:line-break/> <text:s text:c="3"/>voidptr_t pModelBaseAddress, <text:s text:c="2"/>/* Указатель на базовый адрес проецируемого файла */<text:line-break/> <text:s text:c="3"/>uint64_t file_size,<text:line-break/> <text:s text:c="3"/>ECO_RUNTIME_TENSOR_V1_T* pOutTensorA, /* Дескриптор под первый тензор (ID 101) */<text:line-break/> <text:s text:c="3"/>ECO_RUNTIME_TENSOR_V1_T* pOutTensorB <text:s/>/* Дескриптор под второй тензор (ID 102) */<text:line-break/>) {<text:line-break/> <text:s text:c="3"/>const uint8_t* base = (const uint8_t*)pModelBaseAddress;<text:line-break/> <text:s text:c="3"/>uint32_t cbor_size = 0;<text:line-break/> <text:s text:c="3"/>size_t pool_start_offset = 0;<text:line-break/> <text:s text:c="3"/>uint32_t t1_offset_in_pool = 0;<text:line-break/> <text:s text:c="3"/>uint32_t t2_offset_in_pool = 0;<text:line-break/> <text:s text:c="3"/>int16_t status;<text:line-break/><text:line-break/> <text:s text:c="3"/>if (!base || !pOutTensorA || !pOutTensorB) return -2147467261; /* E_POINTER */<text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="2"/>1. ВАЛИДАЦИЯ СИСТЕМНОГО ПРЕФИКСА И ИЗВЛЕЧЕНИЕ CBOR-ПАСПОРТА <text:s text:c="13"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>if (memcmp(base, &quot;ETM1&quot;, 4) != 0) return -401; /* Ошибка: неверная сигнатура файла */<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Чтение размера CBOR (из байт 4-7) */<text:line-break/> <text:s text:c="3"/>memcpy(&amp;cbor_size, base + 4, 4);<text:line-break/> <text:s text:c="3"/>if (8 + cbor_size &gt;= file_size) return -402; /* Ошибка: файл поврежден */<text:line-break/><text:line-break/> <text:s text:c="3"/>const uint8_t* cbor_buf = base + 8;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="2"/>2. СВЕРХБЫСТРЫЙ ПОИСК СМЕЩЕНИЙ ТЕНЗОРОВ В CBOR ПАСПОРТЕ <text:s text:c="17"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>status = _EcoTensor_FindOffsetInCbor(cbor_buf, 101, &amp;t1_offset_in_pool);<text:line-break/> <text:s text:c="3"/>if (status != 0) return status;<text:line-break/><text:line-break/> <text:s text:c="3"/>status = _EcoTensor_FindOffsetInCbor(cbor_buf, 102, &amp;t2_offset_in_pool);<text:line-break/> <text:s text:c="3"/>if (status != 0) return status;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Вычисление физического старта пула тензоров с учетом выравнивания по кэш-лайну */<text:line-break/> <text:s text:c="3"/>pool_start_offset = ((8 + (size_t)cbor_size) + 63) &amp; ~63;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="2"/>3. ВОССТАНОВЛЕНИЕ УКАЗАТЕЛЕЙ ПЕРВОГО ТЕНЗОРА (matrix_A, ID 101) <text:s text:c="9"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/><text:soft-page-break/> <text:s text:c="3"/>size_t t1_abs_offset = pool_start_offset + t1_offset_in_pool;<text:line-break/> <text:s text:c="3"/>if (t1_abs_offset &gt;= file_size) return -403;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Проецируем бинарный заголовок тензора напрямую из памяти mmap */<text:line-break/> <text:s text:c="3"/>const ECO_TENSOR_V1_T* t1_hdr = (const ECO_TENSOR_V1_T*)(base + t1_abs_offset);<text:line-break/> <text:s text:c="3"/>pOutTensorA-&gt;hdr = *t1_hdr;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Вычисление внутренних смещений геометрии и полезных данных первого тензора */<text:line-break/> <text:s text:c="3"/>size_t t1_hdr_bytes <text:s text:c="2"/>= (t1_hdr-&gt;flags &amp; ECO_TENSOR_FLAG_SIMPLE_HDR) ? 8 : 16;<text:line-break/> <text:s text:c="3"/>size_t t1_shape_align = 1 &lt;&lt; t1_hdr-&gt;shape_align;<text:line-break/> <text:s text:c="3"/>size_t t1_data_align <text:s/>= 1 &lt;&lt; t1_hdr-&gt;data_align;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>size_t t1_shape_start = (t1_hdr_bytes + (t1_shape_align - 1)) &amp; ~(t1_shape_align - 1);<text:line-break/> <text:s text:c="3"/>size_t t1_shape_bytes = (size_t)t1_hdr-&gt;ndims * (1 &lt;&lt; t1_hdr-&gt;shape_type);<text:line-break/> <text:s text:c="3"/>size_t t1_data_start <text:s/>= ((t1_shape_start + t1_shape_bytes) + (t1_data_align - 1)) &amp; ~(t1_data_align - 1);<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Привязка внутренних пассивных Си-указателей дескриптора А (Zero-Copy) */<text:line-break/> <text:s text:c="3"/>pOutTensorA-&gt;shape_ptr = (voidptr_t)(base + t1_abs_offset + t1_shape_start);<text:line-break/> <text:s text:c="3"/>pOutTensorA-&gt;data_ptr <text:s/>= (voidptr_t)(base + t1_abs_offset + t1_data_start);<text:line-break/> <text:s text:c="3"/>pOutTensorA-&gt;hdr.flags |= ECO_TENSOR_FLAG_FOREIGN; /* Память принадлежит файлу mmap */<text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="2"/>4. ВОССТАНОВЛЕНИЕ УКАЗАТЕЛЕЙ ВТОРОГО ТЕНЗОРА (matrix_B, ID 102) <text:s text:c="9"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>size_t t2_abs_offset = pool_start_offset + t2_offset_in_pool;<text:line-break/> <text:s text:c="3"/>if (t2_abs_offset &gt;= file_size) return -404;<text:line-break/><text:line-break/> <text:s text:c="3"/>const ECO_TENSOR_V1_T* t2_hdr = (const ECO_TENSOR_V1_T*)(base + t2_abs_offset);<text:line-break/> <text:s text:c="3"/>pOutTensorB-&gt;hdr = *t2_hdr;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Вычисление внутренних смещений геометрии и полезных данных второго тензора */<text:line-break/> <text:s text:c="3"/>size_t t2_hdr_bytes <text:s text:c="2"/>= (t2_hdr-&gt;flags &amp; ECO_TENSOR_FLAG_SIMPLE_HDR) ? 8 : 16;<text:line-break/> <text:s text:c="3"/>size_t t2_shape_align = 1 &lt;&lt; t2_hdr-&gt;shape_align;<text:line-break/> <text:s text:c="3"/>size_t t2_data_align <text:s/>= 1 &lt;&lt; t2_hdr-&gt;data_align;<text:line-break/> <text:s text:c="3"/><text:line-break/> <text:s text:c="3"/>size_t t2_shape_start = (t2_hdr_bytes + (t2_shape_align - 1)) &amp; ~(t2_shape_align - 1);<text:line-break/> <text:s text:c="3"/>size_t t2_shape_bytes = (size_t)t2_hdr-&gt;ndims * (1 &lt;&lt; t2_hdr-&gt;shape_type);<text:line-break/> <text:s text:c="3"/>size_t t2_data_start <text:s/>= ((t2_shape_start + t2_shape_bytes) + (t2_data_align - 1)) &amp; ~(t2_data_align - 1);<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Привязка внутренних пассивных Си-указателей дескриптора B (Zero-Copy) */<text:line-break/> <text:s text:c="3"/>pOutTensorB-&gt;shape_ptr = (voidptr_t)(base + t2_abs_offset + t2_shape_start);<text:line-break/> <text:s text:c="3"/>pOutTensorB-&gt;data_ptr <text:s/>= (voidptr_t)(base + t2_abs_offset + t2_data_start);<text:line-break/> <text:s text:c="3"/>pOutTensorB-&gt;hdr.flags |= ECO_TENSOR_FLAG_FOREIGN;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="2"/>5. СКВОЗНАЯ ВАЛИДАЦИЯ ВОССТАНОВЛЕННЫХ ТЕНЗОРОВ ЯДРОМ <text:s text:c="20"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>if (EcoTensor_FullRuntimeValidation(pOutTensorA) != 0) return -405;<text:line-break/> <text:s text:c="3"/>if (EcoTensor_FullRuntimeValidation(pOutTensorB) != 0) return -406;<text:line-break/><text:line-break/> <text:s text:c="3"/>return 0; /* Модель полностью десериализована и готова к вычислениям */<text:line-break/>}<text:line-break/></text:p>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="P104">Архитектурные преимущества алгоритма 10.4:</text:p>
   <text:list text:style-name="L11">
    <text:list-item>
     <text:p text:style-name="P106"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Исключение фрагментации памяти рантайма:</text:span></text:span><text:span text:style-name="T50"> Алгоритм принимает на вход готовые адреса дескрипторов </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">pOutTensorA</text:span></text:span><text:span text:style-name="T50"> и </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">pOutTensorB</text:span></text:span><text:span text:style-name="T50">, полностью исключая внутренние вызовы </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">malloc</text:span></text:span><text:span text:style-name="T50">. Веса матриц не дублируются в ОЗУ, предотвращая деградацию подсистемы памяти при циклическом инференсе моделей распознавания.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P106"><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Аппаратная независимость разрядности:</text:span></text:span><text:span text:style-name="T50"> Математические сдвиги внутри структуры тензора (</text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">t1_data_start</text:span></text:span><text:span text:style-name="T50">, </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">t2_data_start</text:span></text:span><text:span text:style-name="T50">) рассчитываются динамически на основе открытых полей </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">shape_align</text:span></text:span><text:span text:style-name="T50"> и </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">shape_type</text:span></text:span><text:span text:style-name="T50">. Движок корректно восстановит указатели на данные, даже если </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">matrix_A</text:span></text:span><text:span text:style-name="T50"> использует </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">uint32_t</text:span></text:span><text:span text:style-name="T50"> для описания размеров осей, а </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">matrix_B</text:span></text:span><text:span text:style-name="T50"> использует </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">uint64_t</text:span></text:span><text:span text:style-name="T50">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P106"><text:soft-page-break/><text:span text:style-name="Strong_20_Emphasis"><text:span text:style-name="T49">Безопасность системного сбоя:</text:span></text:span><text:span text:style-name="T50"> Наличие проверок </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">absolute_tensor_offset &gt;= file_size</text:span></text:span><text:span text:style-name="T50"> гарантирует, что поврежденный бинарный файл или некорректно сформированный CBOR-паспорт будут перехвачены на этапе инициализации, исключая падение процесса по ошибке отсутствия страницы памяти (</text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">Segmentation Fault</text:span></text:span><text:span text:style-name="T50"> / </text:span><text:span text:style-name="Source_20_Text"><text:span text:style-name="T23">Page Fault</text:span></text:span><text:span text:style-name="T50">).</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="P91"/>
   <text:p text:style-name="P91"/>
   <text:h text:style-name="P107" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc7682_951195439"/>Приложение А: <text:span text:style-name="T53">Полное </text:span><text:span text:style-name="T38">IDL о</text:span><text:span text:style-name="T53">писание</text:span><text:bookmark-end text:name="__RefHeading___Toc7682_951195439"/><text:bookmark-start text:name="_Toc164524623 Copy 2"/><text:bookmark-start text:name="_Toc168857492 Copy 2"/><text:bookmark-start text:name="_Toc164524623 Copy 1"/><text:bookmark-start text:name="_Toc168857492 Copy 1"/><text:bookmark-start text:name="_Toc168857492"/></text:h>
   <text:p text:style-name="P108"><text:bookmark-end text:name="_Toc168857492"/><text:bookmark-end text:name="_Toc164524623 Copy 2"/><text:bookmark-end text:name="_Toc168857492 Copy 2"/><text:bookmark-end text:name="_Toc164524623 Copy 1"/><text:bookmark-end text:name="_Toc168857492 Copy 1"/><text:bookmark-end text:name="__RefHeading___Toc72889_228845717 Copy 1"/></text:p>
   <text:p text:style-name="P108"/>
   <text:p text:style-name="P66">import &quot;IEcoBase1.h&quot;<text:line-break/><text:line-break/>typedef enum ECO_TENSOR_1_TYPE {<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_UINT8_T <text:s text:c="7"/>= 0x00, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_UINT16_T <text:s text:c="6"/>= 0x01, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_UINT32_T <text:s text:c="6"/>= 0x02, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_UINT64_T <text:s text:c="6"/>= 0x03,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_UINT128_T <text:s text:c="5"/>= 0x04,<text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_INT8_T <text:s text:c="8"/>= 0x05, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_INT16_T <text:s text:c="7"/>= 0x06, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_INT32_T <text:s text:c="7"/>= 0x07, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_INT64_T <text:s text:c="7"/>= 0x08,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_INT128_T <text:s text:c="6"/>= 0x09,<text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_UINT256_T <text:s text:c="5"/>= 0x0A,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_INT256_T <text:s text:c="6"/>= 0x0B,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_UINT512_T <text:s text:c="5"/>= 0x0C,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_INT512_T <text:s text:c="6"/>= 0x0D,<text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_FLOAT16_T <text:s text:c="5"/>= 0x10,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_BFLOAT16_T <text:s text:c="4"/>= 0x11,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_FLOAT32_T <text:s text:c="5"/>= 0x12, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_FLOAT64_T <text:s text:c="5"/>= 0x13,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_FLOAT128_T <text:s text:c="4"/>= 0x14,<text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_FLOAT8_E4M3_T <text:s/>= 0x15, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_FLOAT8_E5M2_T <text:s/>= 0x16, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_FLOAT256_T <text:s text:c="4"/>= 0x17, <text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_COMPLEX64_T <text:s text:c="3"/>= 0x18, <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_COMPLEX128_T <text:s text:c="2"/>= 0x19, <text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_INT4_Q_T <text:s text:c="6"/>= 0x20,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_UINT4_Q_T <text:s text:c="5"/>= 0x21,<text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_BOOL_T <text:s text:c="8"/>= 0x30,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_BIT_T <text:s text:c="9"/>= 0x31,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_STR_T <text:s text:c="9"/>= 0x32,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_OBJECT_T <text:s text:c="6"/>= 0x33,<text:line-break/> <text:line-break/> <text:s text:c="3"/>ECO_TENSOR_1_CUSTOM_T <text:s text:c="6"/>= 0x3F<text:line-break/>} ECO_TENSOR_1_TYPE;<text:line-break/><text:line-break/>typedef enum ECO_TENSOR_FLAGS {<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_LAYOUT_DENSE <text:s text:c="8"/>= 0x0000,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_LAYOUT_CSR <text:s text:c="10"/>= 0x0001,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_LAYOUT_COO <text:s text:c="10"/>= 0x0002,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_LAYOUT_CSF <text:s text:c="10"/>= 0x0003,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_LAYOUT_SPARSE_24 <text:s text:c="4"/>= 0x0004,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_LAYOUT_CSC <text:s text:c="10"/>= 0x0005,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_LAYOUT_ELLPACK <text:s text:c="6"/>= 0x0006,<text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_SIMPLE_HDR <text:s text:c="5"/>= 0x0008,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_COM <text:s text:c="12"/>= 0x0010,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_FOREIGN <text:s text:c="8"/>= 0x0020,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_READONLY <text:s text:c="7"/>= 0x0040,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_VIEW <text:s text:c="11"/>= 0x0080,<text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_PINNED <text:s text:c="9"/>= 0x0100,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_DEVICE <text:s text:c="9"/>= 0x0200,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_SHARED <text:s text:c="9"/>= 0x0400,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_ALIGNED_PAGE <text:s text:c="3"/>= 0x0800,<text:line-break/><text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_THREADSAFE <text:s text:c="5"/>= 0x1000,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_DIRTY <text:s text:c="10"/>= 0x2000,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_CONTIGUOUS <text:s text:c="5"/>= 0x4000,<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_FLAG_CONTINGENT <text:s text:c="5"/>= 0x8000<text:line-break/>} ECO_TENSOR_FLAGS;<text:line-break/><text:line-break/>[pack(1)]<text:line-break/>typedef struct ECO_TENSOR_V1_T {<text:line-break/> <text:s text:c="3"/>uint32_t magic;<text:line-break/> <text:s text:c="3"/>uint32_t ref_count;<text:line-break/> <text:s text:c="3"/>uint16_t ndims;<text:line-break/><text:soft-page-break/> <text:s text:c="3"/>uint16_t flags;<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>data_type;<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>shape_type;<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>data_align;<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>shape_align;<text:line-break/>} ECO_TENSOR_V1_T;<text:line-break/><text:line-break/>[pack(1)]<text:line-break/>typedef struct ECO_SIMPLE_TENSOR_V1_T {<text:line-break/> <text:s text:c="3"/>uint16_t ndims;<text:line-break/> <text:s text:c="3"/>uint16_t flags;<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>data_type;<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>shape_type;<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>data_align;<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>shape_align;<text:line-break/>} ECO_SIMPLE_TENSOR_V1_T;<text:line-break/><text:line-break/>typedef struct ECO_RUNTIME_TENSOR_V1_T {<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>lpVtbl;<text:line-break/> <text:s text:c="3"/>ECO_TENSOR_V1_T hdr;<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>shape_ptr;<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>data_ptr;<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>sparse_indices;<text:line-break/> <text:s text:c="3"/>voidptr_t <text:s text:c="6"/>sparse_indptr;<text:line-break/> <text:s text:c="3"/>uint64_t <text:s text:c="7"/>nnz;<text:line-break/>} ECO_RUNTIME_TENSOR_V1_T;<text:line-break/><text:line-break/><text:line-break/>[<text:line-break/> <text:s text:c="3"/>object,<text:line-break/> <text:s text:c="3"/>uguid({00000000-0000-0000-0000-0001FDFEFF}),<text:line-break/>]<text:line-break/>interface IEcoTensor1 : IEcoUnknown {<text:line-break/><text:line-break/>}</text:p>
   <text:p text:style-name="code_5f_cpp"/>
   <text:p text:style-name="Text_20_body"/>
   <text:h text:style-name="P109" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc7682_951195439 Copy 1"/>Приложение <text:span text:style-name="T57">Б</text:span>: <text:span text:style-name="T57">О</text:span><text:span text:style-name="T53">писание </text:span><text:span text:style-name="T57">на ЯП Си</text:span><text:bookmark-end text:name="__RefHeading___Toc7682_951195439 Copy 1"/></text:h>
   <text:p text:style-name="P110"/>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#ifndef</text:span><text:span text:style-name="T59"> __I_ECO_TENSOR_1_H__</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> __I_ECO_TENSOR_1_H__</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#include</text:span><text:span text:style-name="T59"> </text:span><text:span text:style-name="T60">&quot;IEcoBase1.h&quot;</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#ifndef</text:span><text:span text:style-name="T59"> ECO_TENSOR_V1_T_DEFINED</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* 1. Базовые константы (значения, которые мы ожидаем увидеть в magic) */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_MAGIC_LE 0xFFFEFD01 <text:s/></text:span><text:span text:style-name="T61">/* Little-Endian (младший байт 01 в конце) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_MAGIC_BE 0x01FDFEFF <text:s/></text:span><text:span text:style-name="T61">/* Big-Endian (01 в начале) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_MAGIC_ME 0xFD01FFFE <text:s/></text:span><text:span text:style-name="T61">/* Middle-Endian (PDP-11 стиль) */</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* 2. Проверка порядка байт ТЕНЗОРА (как он записан в структуре) */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_IS_LE(t) ((t)-&gt;magic == ECO_TENSOR_MAGIC_LE)</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_IS_BE(t) ((t)-&gt;magic == ECO_TENSOR_MAGIC_BE)</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_IS_ME(t) ((t)-&gt;magic == ECO_TENSOR_MAGIC_ME)</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* 3. Определение нативной архитектуры системы (Runtime check) */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* Создаем временную переменную и смотрим на её первый байт */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T58">static</text:span><text:span text:style-name="T59"> </text:span><text:span text:style-name="T58">const</text:span><text:span text:style-name="T59"> uint32_t __eco_endian_test = 0x01020304;</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_SYSTEM_IS_LITTLE_ENDIAN() (*((</text:span><text:span text:style-name="T58">const</text:span><text:span text:style-name="T59"> uint8_t*)&amp;__eco_endian_test) == 0x04)</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_SYSTEM_IS_BIG_ENDIAN() <text:s text:c="3"/>(*((</text:span><text:span text:style-name="T58">const</text:span><text:span text:style-name="T59"> uint8_t*)&amp;__eco_endian_test) == 0x01)</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_SYSTEM_IS_MIDDLE_ENDIAN() (*((</text:span><text:span text:style-name="T58">const</text:span><text:span text:style-name="T59"> uint8_t*)&amp;__eco_endian_test) == 0x02)</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* 4. Получение версии из magic (всегда первый байт физической последовательности) */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* Версия 01 всегда лежит по самому первому адресу, независимо от порядка байт системы */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_GET_VERSION(t) (*((uint8_t*)&amp;((t)-&gt;magic)))</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* --- 3. Типы данных (6 бит = 64 значения) --- */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">typedef</text:span><text:span text:style-name="T59"> </text:span><text:span text:style-name="T58">enum</text:span><text:span text:style-name="T59"> ECO_TENSOR_1_TYPE {</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/></text:span><text:span text:style-name="T61">/* Целые беззнаковые */</text:span></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_UINT8_T <text:s text:c="7"/>= 0x00, <text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_UINT16_T <text:s text:c="6"/>= 0x01, <text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_UINT32_T <text:s text:c="6"/>= 0x02, <text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_UINT64_T <text:s text:c="6"/>= 0x03,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_UINT128_T <text:s text:c="5"/>= 0x04,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/></text:span><text:span text:style-name="T61">/* Целые знаковые */</text:span></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_INT8_T <text:s text:c="8"/>= 0x05, <text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_INT16_T <text:s text:c="7"/>= 0x06, <text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_INT32_T <text:s text:c="7"/>= 0x07, <text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_INT64_T <text:s text:c="7"/>= 0x08,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_INT128_T <text:s text:c="6"/>= 0x09,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/></text:span><text:span text:style-name="T61">/* Сверхбольшие целые */</text:span></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_UINT256_T <text:s text:c="5"/>= 0x0A,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_INT256_T <text:s text:c="6"/>= 0x0B,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_UINT512_T <text:s text:c="5"/>= 0x0C,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_INT512_T <text:s text:c="6"/>= 0x0D,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/></text:span><text:span text:style-name="T61">/* Плавающая точка */</text:span></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_FLOAT16_T <text:s text:c="5"/>= 0x10,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_BFLOAT16_T <text:s text:c="4"/>= 0x11,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_FLOAT32_T <text:s text:c="5"/>= 0x12, <text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_FLOAT64_T <text:s text:c="5"/>= 0x13,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_FLOAT128_T <text:s text:c="4"/>= 0x14,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/></text:span><text:span text:style-name="T61">/* Новые стандарты FP8 (8-битная плавающая точка) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>ECO_TENSOR_1_FLOAT8_E4M3_T <text:s/>= 0x15, </text:span><text:span text:style-name="T61">/* Высокая точность: 1 бит знак, 4 экспонента, 3 мантисса */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>ECO_TENSOR_1_FLOAT8_E5M2_T <text:s/>= 0x16, </text:span><text:span text:style-name="T61">/* Высокий диапазон: 1 бит знак, 5 экспонента, 2 мантисса */</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/></text:span><text:span text:style-name="T61">/* Сверхточная плавающая точка */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>ECO_TENSOR_1_FLOAT256_T <text:s text:c="4"/>= 0x17, </text:span><text:span text:style-name="T61">/* Octuple precision */</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/></text:span><text:span text:style-name="T61">/* Сложные типы */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>ECO_TENSOR_1_COMPLEX64_T <text:s text:c="3"/>= 0x18, </text:span><text:span text:style-name="T61">/* 2 x float32 */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>ECO_TENSOR_1_COMPLEX128_T <text:s text:c="2"/>= 0x19, </text:span><text:span text:style-name="T61">/* 2 x float64 (ECO_DOUBLE_COMPLEX_T) */</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/></text:span><text:span text:style-name="T61">/* Квантованные типы (AI) */</text:span></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_INT4_Q_T <text:s text:c="6"/>= 0x20,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_UINT4_Q_T <text:s text:c="5"/>= 0x21,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:soft-page-break/><text:span text:style-name="T59"><text:s text:c="4"/></text:span><text:span text:style-name="T61">/* Системные */</text:span></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_BOOL_T <text:s text:c="8"/>= 0x30,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_BIT_T <text:s text:c="9"/>= 0x31,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_STR_T <text:s text:c="9"/>= 0x32,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_OBJECT_T <text:s text:c="6"/>= 0x33,<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/><text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:s text:c="4"/>ECO_TENSOR_1_CUSTOM_T <text:s text:c="6"/>= 0x3F<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">} ECO_TENSOR_1_TYPE;<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* <text:s text:c="2"/>ГРУППА 1: Математическая топология и разреженность (Биты 0-3, маска 0x000F) */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_LAYOUT_MASK <text:s text:c="9"/>0x000F</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_LAYOUT_DENSE <text:s text:c="8"/>0x0000 <text:s/></text:span><text:span text:style-name="T61">/* Полный многомерный плотный тензор (любые данные) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_LAYOUT_CSR <text:s text:c="10"/>0x0001 <text:s/></text:span><text:span text:style-name="T61">/* Разреженная матрица: Compressed Sparse Row (строго 2D или выпрямленный) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_LAYOUT_COO <text:s text:c="10"/>0x0002 <text:s/></text:span><text:span text:style-name="T61">/* Универсальный N-мерный координатный формат (строго [nnz, ndims]) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_LAYOUT_CSF <text:s text:c="10"/>0x0003 <text:s/></text:span><text:span text:style-name="T61">/* Compressed Sparse Fiber (N-мерный аналог CSR через дерево осей) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_LAYOUT_SPARSE_24 <text:s text:c="4"/>0x0004 <text:s/></text:span><text:span text:style-name="T61">/* Структурированная ИИ-разреженность (блоки 2 элемента из 4, NVIDIA Ampere+) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_LAYOUT_CSC <text:s text:c="10"/>0x0005 <text:s/></text:span><text:span text:style-name="T61">/* Разреженная матрица: Compressed Sparse Column (для оптимизации по столбцам) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_LAYOUT_ELLPACK <text:s text:c="6"/>0x0006 <text:s/></text:span><text:span text:style-name="T61">/* Формат ELL: фиксированное число ненулевых элементов в строке (векторизация) */</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* <text:s text:c="2"/>ГРУППА 2: Жизненный цикл, бинарный формат и права (Биты 4-7, маска 0x00F0) */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_SIMPLE_HDR <text:s text:c="5"/>0x0008 <text:s/></text:span><text:span text:style-name="T61">/* КРИТИЧЕСКИЙ ФЛАГ: используется упрощенный 8-байтовый заголовок для N-мерных данных */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_COM <text:s text:c="12"/>0x0010 <text:s/></text:span><text:span text:style-name="T61">/* Объект управляется через интерфейс COM/Vtable (включает lpVtbl) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_FOREIGN <text:s text:c="8"/>0x0020 <text:s/></text:span><text:span text:style-name="T61">/* Данные внешние (SaC / стороннее ПО). Деструктор НЕ вызывает free() */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_READONLY <text:s text:c="7"/>0x0040 <text:s/></text:span><text:span text:style-name="T61">/* Память только для чтения (Memory Map / Срез без права мутации) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_VIEW <text:s text:c="11"/>0x0080 <text:s/></text:span><text:span text:style-name="T61">/* Срез / Мягкая копия (Тензор разделяет память data_ptr с другим тензором) */</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* <text:s text:c="2"/>ГРУППА 3: Аппаратное размещение и оптимизация (Биты 8-11, маска 0x0F00) */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_PINNED <text:s text:c="9"/>0x0100 <text:s/></text:span><text:span text:style-name="T61">/* Память хоста заблокирована (Page-Locked / Pinned) для сверхбыстрого DMA */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_DEVICE <text:s text:c="9"/>0x0200 <text:s/></text:span><text:span text:style-name="T61">/* Данные физически на ускорителе (CUDA Pointer / OpenCL / Vulkan buffer) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_SHARED <text:s text:c="9"/>0x0400 <text:s/></text:span><text:span text:style-name="T61">/* Межпроцессная разделяемая память (IPC Shared Memory Buffer) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_ALIGNED_PAGE <text:s text:c="3"/>0x0800 <text:s/></text:span><text:span text:style-name="T61">/* Физический адрес данных выровнен по границе системной страницы (4КБ/2МБ) */</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* <text:s text:c="2"/>ГРУППА 4: Потоковая модель и состояние расчетов (Биты 12-15, маска 0xF000) */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_THREADSAFE <text:s text:c="5"/>0x1000 <text:s/></text:span><text:span text:style-name="T61">/* ref_count инкрементируется ИСКЛЮЧИТЕЛЬНО через атомарные инструкции */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_DIRTY <text:s text:c="10"/>0x2000 <text:s/></text:span><text:span text:style-name="T61">/* Данные были изменены на CPU, но не синхронизированы с кешем GPU (или диском) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_CONTIGUOUS <text:s text:c="5"/>0x4000 <text:s/></text:span><text:span text:style-name="T61">/* Гарантированная непрерывность памяти по всем осям (нет кастомных strides) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_FLAG_CONTINGENT <text:s text:c="5"/>0x8000 <text:s/></text:span><text:span text:style-name="T61">/* Внутреннее резервное поле / Флаг отложенного ленивого вычисления (Lazy) */</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* <text:s text:c="2"/>Вспомогательные макросы быстрой проверки состояния (Предикаты) <text:s text:c="10"/>*/<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* ========================================================================== */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_GET_LAYOUT(t) <text:s text:c="7"/>((t)-&gt;flags &amp; ECO_TENSOR_LAYOUT_MASK)</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_IS_DENSE(t) <text:s text:c="9"/>(ECO_TENSOR_GET_LAYOUT(t) == ECO_TENSOR_LAYOUT_DENSE)</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_IS_SPARSE(t) <text:s text:c="8"/>(ECO_TENSOR_GET_LAYOUT(t) &gt;= ECO_TENSOR_LAYOUT_CSR)</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* Предикат проверки формата физического заголовка (8 байт против 16 байт) */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_IS_SIMPLE_HDR(t) <text:s text:c="4"/>((t)-&gt;flags &amp; ECO_TENSOR_FLAG_SIMPLE_HDR)</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_CAN_MUTATE(t) <text:s text:c="7"/>(!((t)-&gt;flags &amp; ECO_TENSOR_FLAG_READONLY))</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_IS_ON_DEVICE(t) <text:s text:c="5"/>((t)-&gt;flags &amp; ECO_TENSOR_FLAG_DEVICE)</text:span></text:p>
   <text:p text:style-name="P66"><text:soft-page-break/><text:span text:style-name="T58">#define</text:span><text:span text:style-name="T59"> ECO_TENSOR_IS_THREADSAFE(t) <text:s text:c="4"/>((t)-&gt;flags &amp; ECO_TENSOR_FLAG_THREADSAFE)</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* Структура тензора первой версии */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* --- Полная машинно-программная версия заголовка (Ровно 16 байт) --- */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#pragma</text:span><text:span text:style-name="T59"> </text:span><text:span text:style-name="T58">pack</text:span><text:span text:style-name="T59">(</text:span><text:span text:style-name="T58">push</text:span><text:span text:style-name="T59">, 1)</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">typedef</text:span><text:span text:style-name="T59"> </text:span><text:span text:style-name="T58">struct</text:span><text:span text:style-name="T59"> ECO_TENSOR_V1_T {</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint32_t magic; <text:s text:c="6"/></text:span><text:span text:style-name="T61">/* [0-3] <text:s text:c="2"/>Версия + Magic + Endianness */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint32_t ref_count; <text:s text:c="2"/></text:span><text:span text:style-name="T61">/* [4-7] <text:s text:c="2"/>Счетчик ссылок для SaC и COM (выровнен по 4 байта) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint16_t ndims; <text:s text:c="6"/></text:span><text:span text:style-name="T61">/* [8-9] <text:s text:c="2"/>Количество измерений (выровнен по 2 байта) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint16_t flags; <text:s text:c="6"/></text:span><text:span text:style-name="T61">/* [10-11] Флаги формата (SIMPLE, DENSE, CSR, COO) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint8_t <text:s/>data_type; <text:s text:c="2"/></text:span><text:span text:style-name="T61">/* [12] <text:s text:c="3"/>Тип данных элементов тензора */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint8_t <text:s/>shape_type; <text:s/></text:span><text:span text:style-name="T61">/* [13] <text:s text:c="3"/>Тип данных элементов shape */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint8_t <text:s/>data_align; <text:s/></text:span><text:span text:style-name="T61">/* [14] <text:s text:c="3"/>Выравнивание данных (степень двойки) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint8_t <text:s/>shape_align; </text:span><text:span text:style-name="T61">/* [15] <text:s text:c="3"/>Выравнивание shape (степень двойки) */</text:span></text:p>
   <text:p text:style-name="P66">} ECO_TENSOR_V1_T;<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#pragma</text:span><text:span text:style-name="T59"> </text:span><text:span text:style-name="T58">pack</text:span><text:span text:style-name="T59">(</text:span><text:span text:style-name="T58">pop</text:span><text:span text:style-name="T59">)</text:span></text:p>
   <text:p text:style-name="P66"/>
   <text:p text:style-name="P66">/* --- Облегченная (Simple) версия заголовка (Ровно 8 байт) --- */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66">/* Используется, когда нет нужды в COM-интерфейсах, управлении памятью и magic-проверках */<text:span text:style-name="T59"/></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">#pragma</text:span><text:span text:style-name="T59"> </text:span><text:span text:style-name="T58">pack</text:span><text:span text:style-name="T59">(</text:span><text:span text:style-name="T58">push</text:span><text:span text:style-name="T59">, 1)</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T58">typedef</text:span><text:span text:style-name="T59"> </text:span><text:span text:style-name="T58">struct</text:span><text:span text:style-name="T59"> ECO_SIMPLE_TENSOR_V1_T {</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint16_t ndims; <text:s text:c="6"/></text:span><text:span text:style-name="T61">/* [0-1] <text:s text:c="2"/>Количество измерений (в Simple всегда должно быть 1) */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint16_t flags; <text:s text:c="6"/></text:span><text:span text:style-name="T61">/* [2-3] <text:s text:c="2"/>Флаги формата */</text:span></text:p>
   <text:p text:style-name="P66"><text:span text:style-name="T59"><text:s text:c="4"/>uint8_t <text:s/>data_type; <text:s text:c="2"/></text:span><text:span text:style-name="T61">/* [4] <text:s text:c="4"/>Тип данных элементов тензора */</text:span></text:p>
