   <text:p text:style-name="P51"><text:s text:c="4"/>);<text:span text:style-name="T35"/></text:p>
   <text:p text:style-name="P51"><text:span text:style-name="T35"/></text:p>
   <text:p text:style-name="P51"><text:s text:c="4"/>int16_t ConnectNodes(<text:span text:style-name="T35"/></text:p>
   <text:p text:style-name="P51"><text:span text:style-name="T35"><text:s text:c="8"/>[</text:span><text:span text:style-name="T34">in</text:span><text:span text:style-name="T35">] ECO_SIMPLEX_V1_T* pSourceNode, </text:span></text:p>
   <text:p text:style-name="P51"><text:span text:style-name="T35"><text:s text:c="8"/>[</text:span><text:span text:style-name="T34">in</text:span><text:span text:style-name="T35">] uint32_t portIndex, </text:span></text:p>
   <text:p text:style-name="P51"><text:span text:style-name="T35"><text:s text:c="8"/>[</text:span><text:span text:style-name="T34">in</text:span><text:span text:style-name="T35">] ECO_SIMPLEX_V1_T* pTargetNode</text:span></text:p>
   <text:p text:style-name="P51"><text:s text:c="4"/>);<text:span text:style-name="T35"/></text:p>
   <text:p text:style-name="P51"><text:span text:style-name="T35"/></text:p>
   <text:p text:style-name="P51"><text:s text:c="4"/>int16_t DisconnectPort(<text:span text:style-name="T35"/></text:p>
   <text:p text:style-name="P51"><text:span text:style-name="T35"><text:s text:c="8"/>[</text:span><text:span text:style-name="T34">in</text:span><text:span text:style-name="T35">] ECO_SIMPLEX_V1_T* pNode, </text:span></text:p>
   <text:p text:style-name="P51"><text:span text:style-name="T35"><text:s text:c="8"/>[</text:span><text:span text:style-name="T34">in</text:span><text:span text:style-name="T35">] uint32_t portIndex,</text:span></text:p>
   <text:p text:style-name="P51"><text:span text:style-name="T35"><text:s text:c="8"/>[</text:span><text:span text:style-name="T34">out</text:span><text:span text:style-name="T35">, </text:span><text:span text:style-name="T34">retval</text:span><text:span text:style-name="T35">] ECO_SIMPLEX_V1_T** ppOutNode</text:span></text:p>
   <text:p text:style-name="P51"><text:s text:c="4"/>);<text:span text:style-name="T35"/></text:p>
