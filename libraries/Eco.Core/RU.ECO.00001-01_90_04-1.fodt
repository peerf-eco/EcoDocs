   <text:p text:style-name="P51"><text:span text:style-name="T35"><text:s text:c="8"/>[</text:span><text:span text:style-name="T34">in</text:span><text:span text:style-name="T35">] ECO_SIMPLEX_V1_T* pNode, </text:span></text:p>
   <text:p text:style-name="P51"><text:span text:style-name="T35"><text:s text:c="8"/>[</text:span><text:span text:style-name="T34">in</text:span><text:span text:style-name="T35">] uint32_t portIndexA, </text:span></text:p>
