   <text:h text:style-name="P102" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc7682_951195439"/>Приложение А: <text:span text:style-name="T71">Полное </text:span><text:span text:style-name="T51">IDL о</text:span><text:span text:style-name="T71">писание</text:span><text:bookmark-end text:name="__RefHeading___Toc7682_951195439"/><text:bookmark-start text:name="_Toc168857492"/><text:bookmark-start text:name="_Toc168857492 Copy 1"/><text:bookmark-start text:name="_Toc164524623 Copy 1"/><text:bookmark-start text:name="_Toc168857492 Copy 2"/><text:bookmark-start text:name="_Toc164524623 Copy 2"/></text:h>
   <text:p text:style-name="P103"><text:bookmark-end text:name="__RefHeading___Toc72889_228845717 Copy 1"/><text:bookmark-end text:name="_Toc168857492 Copy 1"/><text:bookmark-end text:name="_Toc164524623 Copy 1"/><text:bookmark-end text:name="_Toc168857492 Copy 2"/><text:bookmark-end text:name="_Toc164524623 Copy 2"/><text:bookmark-end text:name="_Toc168857492"/></text:p>
   <text:p text:style-name="P103"/>
   <text:p text:style-name="P104">/*<text:line-break/> * &lt;summary&gt;<text:line-break/> * <text:s text:c="2"/>Stateless Service-Oriented Eco IDL Specification for Simplex V1<text:line-break/> * &lt;/summary&gt;<text:line-break/> * &lt;description&gt;<text:line-break/> * <text:s text:c="2"/>This file defines the interface contract for a stateless domain service <text:line-break/> * <text:s text:c="2"/>that manipulates intrusive memory cells (ECO_SIMPLEX_V1_T) directly <text:line-break/> * <text:s text:c="2"/>via raw hardware memory pointers.<text:line-break/> * &lt;/description&gt;<text:line-break/> */<text:line-break/><text:line-break/>#include &quot;IEcoBase1.idl&quot;<text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="14"/>CORE ABI STRUCTURE DEFINITIONS &amp; DESCRIPTORS <text:s text:c="16"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/><text:line-break/>/* Monolithic Intrusive Memory Cell (Graph/Topology Atom) */<text:line-break/>typedef [public] struct ECO_SIMPLEX_V1_T {<text:line-break/> <text:s text:c="3"/>/* Block 1: Management &amp; Execution Metadata (8 Bytes fixed) */<text:line-break/> <text:s text:c="3"/>uint32_t ref_count; <text:s text:c="4"/>/* Atomic reference counter for node lifecycle tracking */<text:line-break/> <text:s text:c="3"/>uint16_t node_flags; <text:s text:c="3"/>/* Binary status masks (e.g., SIMPLE_HDR, LINE, TREE) */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>struct_type; <text:s text:c="2"/>/* Active logical abstraction container ID (e.g., MAP_T) */<text:line-break/> <text:s text:c="3"/>uint8_t <text:s/>layout_align; <text:s/>/* Memory pool/Arena physical byte alignment exponent */<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Block 2: Topological Connection Matrix (16 Bytes on x86 / 32 Bytes on x64) */<text:line-break/> <text:s text:c="3"/>voidptr_t ports[4]; <text:s text:c="3"/>/* Array of direct hardware RAM pointers to adjacent atoms */<text:line-break/><text:line-break/> <text:s text:c="3"/>/* Block 3: Cache-aligned Payload Block (Strictly 16 Bytes) */<text:line-break/> <text:s text:c="3"/>ECO_VARIANT_V1_T variant; /* Uniform cross-platform unified variant record */<text:line-break/>} ECO_SIMPLEX_V1_T;<text:line-break/><text:line-break/>/* Interface Pointer Type Descriptor alias */<text:line-break/>typedef ECO_SIMPLEX_V1_T* ECO_SIMPLEX_V1_PTR_t;<text:line-break/><text:line-break/>/* Lightweight Runtime Context Cursor for Sequenced or Non-recursive Wave Walks */<text:line-break/>typedef [public] struct ECO_SIMPLEX_ITERATOR_V1_T {<text:line-break/> <text:s text:c="3"/>uint64_t container_head; /* Physical address of the guard Sentinel Node (Loop barrier) */<text:line-break/> <text:s text:c="3"/>uint64_t current_node; <text:s text:c="2"/>/* Current active cursor tracking target variant address */<text:line-break/> <text:s text:c="3"/>uint16_t container_type; /* Engine collection marker governing traversal step rules */<text:line-break/> <text:s text:c="3"/>uint16_t state_flags; <text:s text:c="3"/>/* Local inner state bitmasks for navigational tracking */<text:line-break/> <text:s text:c="3"/>uint64_t traverse_stack; /* Handle to non-recursive dynamic graph traversal context */<text:line-break/>} ECO_SIMPLEX_ITERATOR_V1_T;<text:line-break/><text:line-break/>/* Core positional strategies for Simplex iterator initialization */<text:line-break/>typedef [public] enum ECO_SIMPLEX_ITER_POSITION {<text:line-break/> <text:s text:c="3"/>ECO_SIMPLEX_ITER_BEGIN <text:s/>= 0, <text:s text:c="2"/>/* Direct cursor to the first valid data node */<text:line-break/> <text:s text:c="3"/>ECO_SIMPLEX_ITER_END <text:s text:c="3"/>= 1, <text:s text:c="2"/>/* Position cursor past the tail (System NULL) */<text:line-break/> <text:s text:c="3"/>ECO_SIMPLEX_ITER_CUSTOM = 2 <text:s text:c="3"/>/* Force cursor to a specific custom node pointer */<text:line-break/>} ECO_SIMPLEX_ITER_POSITION;<text:line-break/><text:line-break/><text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/> <text:s text:c="3"/>/* <text:s text:c="14"/>CORE TOPOLOGY INTERFACE CONTRACT <text:s text:c="28"/>*/<text:line-break/> <text:s text:c="3"/>/* ========================================================================== */<text:line-break/><text:line-break/>[<text:line-break/> <text:s text:c="3"/>object,<text:line-break/> <text:s text:c="3"/>uuid(00000000-0000-0000-0000-0001FDFEFF),<text:line-break/> <text:s text:c="3"/>pointer_default(unique),<text:line-break/> <text:s text:c="3"/>helpstring(&quot;IEcoSimplex1: Low-level Atom Factory and Port Commutator Interface&quot;)<text:line-break/>]<text:line-break/>interface IEcoSimplex1 : IEcoUnknown<text:line-break/>{<text:line-break/> <text:s text:c="3"/>/* --- Group 1: Memory Pool Allocation &amp; Arena Lifecycle Management --- */ <text:line-break/> <text:s text:c="3"/>[helpstring(&quot;Allocates a clean, fixed-geometry memory cell from the monolithic Arena pool&quot;)]<text:line-break/> <text:s text:c="3"/>int16_t AllocNode(<text:line-break/> <text:s text:c="7"/>[in] uint8_t structType, <text:line-break/> <text:s text:c="7"/>[out, retval] ECO_SIMPLEX_V1_T** ppNode<text:line-break/> <text:s text:c="3"/>);<text:line-break/><text:line-break/> <text:s text:c="3"/>[helpstring(&quot;Decrements ref_count and cascades the atom back to the Arena free block list&quot;)]<text:line-break/> <text:s text:c="3"/>int16_t FreeNode(<text:line-break/> <text:s text:c="7"/>[in] ECO_SIMPLEX_V1_T* pNode<text:line-break/> <text:s text:c="3"/>);<text:line-break/><text:soft-page-break/><text:line-break/> <text:s text:c="3"/>/* --- Group 2: Low-Level Intrusive Topology Commutation --- */<text:line-break/> <text:s text:c="3"/>[helpstring(&quot;Establishes a direct hardware link between two nodes via chosen slot index (0-3)&quot;)]<text:line-break/> <text:s text:c="3"/>int16_t ConnectNodes(<text:line-break/> <text:s text:c="7"/>[in] ECO_SIMPLEX_V1_T* pSourceNode, <text:line-break/> <text:s text:c="7"/>[in] uint32_t portIndex, <text:line-break/> <text:s text:c="7"/>[in] ECO_SIMPLEX_V1_T* pTargetNode<text:line-break/> <text:s text:c="3"/>);<text:line-break/><text:line-break/> <text:s text:c="3"/>[helpstring(&quot;Severs an active connection at the given slot index, reverting address to NULL&quot;)]<text:line-break/> <text:s text:c="3"/>int16_t DisconnectPort(<text:line-break/> <text:s text:c="7"/>[in] ECO_SIMPLEX_V1_T* pNode, <text:line-break/> <text:s text:c="7"/>[in] uint32_t portIndex,<text:line-break/> <text:s text:c="7"/>[out, retval] ECO_SIMPLEX_V1_T** ppOutNode<text:line-break/> <text:s text:c="3"/>);<text:line-break/><text:line-break/> <text:s text:c="3"/>[helpstring(&quot;Atomically swaps link addresses in two slots of a node to execute tree rotations&quot;)]<text:line-break/> <text:s text:c="3"/>int16_t SwapPorts(<text:line-break/> <text:s text:c="7"/>[in] ECO_SIMPLEX_V1_T* pNode, <text:line-break/> <text:s text:c="7"/>[in] uint32_t portIndexA, <text:line-break/> <text:s text:c="7"/>[in] uint32_t portIndexB<text:line-break/> <text:s text:c="3"/>);<text:line-break/><text:line-break/> <text:s text:c="3"/>/* --- Group 3: Navigational Iterators &amp; Enumeration Controls --- */<text:line-break/> <text:s text:c="3"/>[helpstring(&quot;Initializes a new runtime cursor bound to the target container Sentinel node&quot;)]<text:line-break/> <text:s text:c="3"/>int16_t CreateIterator(<text:line-break/> <text:s text:c="7"/>[in] ECO_SIMPLEX_V1_T* pContainerSentinel, <text:line-break/> <text:s text:c="7"/>[in] uint32_t initPosition, <text:line-break/> <text:s text:c="7"/>[out] ECO_SIMPLEX_ITERATOR_V1_T* pIterator<text:line-break/> <text:s text:c="3"/>);<text:line-break/><text:line-break/> <text:s text:c="3"/>[helpstring(&quot;Increments the tracking cursor position following inner collection rules&quot;)]<text:line-break/> <text:s text:c="3"/>int16_t IteratorNext(<text:line-break/> <text:s text:c="7"/>[in, out] ECO_SIMPLEX_ITERATOR_V1_T* pIterator<text:line-break/> <text:s text:c="3"/>);<text:line-break/><text:line-break/> <text:s text:c="3"/>[helpstring(&quot;Verifies if the traversal cursor has reached the terminal Sentinel boundary&quot;)]<text:line-break/> <text:s text:c="3"/>bool_t IteratorHasNext(<text:line-break/> <text:s text:c="7"/>[in] ECO_SIMPLEX_ITERATOR_V1_T* pIterator<text:line-break/> <text:s text:c="3"/>);<text:line-break/>};<text:line-break/><text:line-break/></text:p>
   <text:p text:style-name="code_5f_cpp"/>
   <text:p text:style-name="Text_20_body"/>
   <text:h text:style-name="P105" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc7682_951195439 Copy 1"/>Приложение <text:span text:style-name="T72">Б</text:span>: <text:span text:style-name="T72">О</text:span><text:span text:style-name="T71">писание </text:span><text:span text:style-name="T72">на ЯП Си</text:span><text:bookmark-end text:name="__RefHeading___Toc7682_951195439 Copy 1"/></text:h>
