   <text:p text:style-name="P51"><text:span text:style-name="T35"><text:s text:c="8"/>[</text:span><text:span text:style-name="T34">out</text:span><text:span text:style-name="T35">, </text:span><text:span text:style-name="T34">retval</text:span><text:span text:style-name="T35">] ECO_SIMPLEX_V1_T** ppNode</text:span></text:p>
